# Shared by every image built from the monorepo root:
#   docker build -f Dockerfile            → backend API  (Coolify Location /Dockerfile)
#   docker build -f frontend/Dockerfile   → React SPA    (Coolify Location /frontend/Dockerfile)
#   docker build -f web/Dockerfile        → Astro site   (Coolify Location /web/Dockerfile)
#
# Context MUST be the repository root so images can COPY packages/shared.
# Do NOT exclude frontend/, web/, or packages/shared/.
# Do NOT exclude backend/ (API build).
# Do NOT set Coolify Base Directory to /frontend, /web, or /backend.

.git
.github
**/.env
**/.env.*
!**/.env.example
node_modules
**/node_modules
coverage
dist
build
.astro
.vite
*.tsbuildinfo
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
docs
*.md
.cursor
.vscode
.idea
