# Backend runtime environment (SYSTEM_PROMPT §14 — these are RUNTIME vars in Coolify).
# Copy to .env for local development. NEVER commit a real .env or real secrets.

NODE_ENV=development
PORT=4000

# Local docker-compose defaults (see docker-compose.yml at the repo root).
DATABASE_URL=postgresql://somwave:somwave@localhost:5432/somwave
REDIS_URL=redis://localhost:6379
# Coolify Redis has requirepass. A host-only REDIS_URL causes NOAUTH and /health 503.
# Either embed the password: redis://:PASSWORD@<redis-uuid>:6379
# or keep REDIS_URL as redis://<redis-uuid>:6379 and set REDIS_PASSWORD.
# REDIS_PASSWORD=
# REDIS_USERNAME=default

# Must be at least 32 characters. Generate a fresh random value per environment.
JWT_SECRET=replace-with-a-32-char-minimum-random-secret

# Comma-separated allow-list of browser origins (never "*"). Credentials are
# required, so the API reflects an exact Origin — not a wildcard.
# Local: Vite dashboard = 5173, Astro public site = 4321.
# Coolify Runtime must include every production origin that calls the API:
#   https://app.somwave.botandev.com
#   https://somwave.botandev.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# Transactional email through the Resend HTTPS API. Configure these as backend
# runtime secrets in Coolify; never add the API key to Vite/frontend variables.
# Verify the botandev.com sending domain in Resend before production sending.
# RESEND_API_KEY=re_your_real_api_key
# EMAIL_FROM=Somwave Solution <noreply@botandev.com>
# EMAIL_NOTIFY_TO=info@botandev.com
# EMAIL_SUPPORT=support@botandev.com
# Public dashboard URL for secure engineer activation and password-reset links.
# APP_PUBLIC_URL=https://app.somwave.botandev.com

# Background jobs: set false on API replicas when running one dedicated
# `npm run worker --workspace @somwave/backend` process.
# BACKGROUND_WORKERS_ENABLED=true
# Exact comma-separated public HTTPS hostnames that health checks may contact.
# Production system URLs outside this list are never probed.
# HEALTH_PROBE_HOSTS=app.example.com,status.example.com

# EVC Plus (P4.2) — set all four together in the deployed runtime.
# PAYMENT_EVC_API_URL=https://api.evcplus.example/v1
# PAYMENT_EVC_API_KEY=replace-with-gateway-api-key
# PAYMENT_EVC_MERCHANT_ID=replace-with-merchant-id
# PAYMENT_EVC_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# Optional: default SUPER_ADMIN user for `npm run db:seed` (backend/prisma/seed.ts).
# In production, set both at runtime in Coolify — never commit real values.
# Locally, if unset in non-production, seed uses dev-only defaults (see docs/SUPER_ADMIN_SETUP.md).
# SEED_SUPER_ADMIN_EMAIL=admin@somwave.com
# SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Object storage for uploads (S3 or Cloudflare R2). Optional in local development:
# files stay in process memory. Required in production — binaries are never stored
# in Postgres. Set all three of bucket, access key, and secret together.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# GitHub App integration (optional until an organization installs the app).
# Store these only in the backend runtime secret manager, never in Vite/Astro
# build variables or repository files. The private key must be PEM text; a
# literal \\n sequence is accepted when secret storage supports only one line.
# Configure the App webhook URL as /api/v1/github/webhooks and grant only the
# repository metadata, issues, pull requests, checks, and releases it needs.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Durable upload provider. Omit STORAGE_PROVIDER to retain existing S3 auto-detection.
# Prefer existing S3 configuration; filesystem requires a real Coolify persistent volume.
# STORAGE_PROVIDER=s3
# S3_FORCE_PATH_STYLE=false
# Alternative: STORAGE_PROVIDER=filesystem and mount a persistent volume at this absolute path.
# STORAGE_LOCAL_PATH=/data/uploads

# ImageKit — stores and delivers every uploaded image (CMS, Media Library, project
# attachments). Backend runtime variables only: never VITE_*/PUBLIC_*, never committed.
# Private key: ImageKit dashboard → Developer options. URL endpoint: https://ik.imagekit.io/<id>
# The server SDK needs only the private key and endpoint; the public key is optional.
# PDFs and other documents keep using the S3/filesystem provider above.
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# IMAGEKIT_PUBLIC_KEY=
