# Backend runtime environment (SYSTEM_PROMPT §14 — these are RUNTIME vars in Coolify).
# Copy to .env for local development. NEVER commit a real .env or real secrets.

NODE_ENV=development
PORT=4000

# Local docker-compose defaults (see docker-compose.yml at the repo root).
DATABASE_URL=postgresql://somwave:somwave@localhost:5432/somwave
REDIS_URL=redis://localhost:6379

# Must be at least 32 characters. Generate a fresh random value per environment.
JWT_SECRET=replace-with-a-32-char-minimum-random-secret

# Comma-separated allow-list of frontend origins (never "*"). Vite=5173, Astro=4321.
CORS_ORIGINS=http://localhost:5173,http://localhost:4321
