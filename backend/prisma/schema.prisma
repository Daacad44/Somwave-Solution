enum DocumentationFormat {
  MARKDOWN
  RICH_TEXT
  FILE
}

enum DocumentationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

model ProjectDocumentation {
  id             String              @id @default(cuid())
  projectId      String              @map("project_id")
  title          String
  category       String?
  folder         String?
  format         DocumentationFormat @default(MARKDOWN)
  content        String?
  storageKey     String?             @map("storage_key")
  fileName       String?             @map("file_name")
  mimeType       String?             @map("mime_type")
  sizeBytes      Int?                @map("size_bytes")
  status         DocumentationStatus @default(DRAFT)
  clientVisible  Boolean             @default(false) @map("client_visible")
  currentVersion Int                 @default(1) @map("current_version")
  ownerId        String?             @map("owner_id")
  createdById    String              @map("created_by_id")
  updatedById    String?             @map("updated_by_id")
  approvedById   String?             @map("approved_by_id")
  approvedAt     DateTime?           @map("approved_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner          User?                   @relation("DocumentationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("DocumentationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?                   @relation("DocumentationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy     User?                   @relation("DocumentationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  versions       DocumentationVersion[]
  comments       DocumentationComment[]
  taskLinks      DocumentTaskLink[]
  milestoneLinks DocumentMilestoneLink[]
  planProposals  DocumentPlanProposal[]
  attachments    DocumentAttachmentLink[] @relation("DocumentationAttachmentParent")
  attachedTo     DocumentAttachmentLink[] @relation("DocumentationAttachmentFile")

  @@index([projectId, status])
  @@index([projectId, category])
  @@index([ownerId])
  @@map("project_documentation")
}

model DocumentationComment {
  id         String    @id @default(cuid())
