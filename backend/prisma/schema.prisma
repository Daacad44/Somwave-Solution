model EngineerProfile {
  userId              String                     @id @map("user_id")
  status              EngineerAccountStatus      @default(ACTIVE)
  phone               String?
  jobTitle            String?                    @map("job_title")
  specialization      String?
  secondarySpecializations String[]            @default([]) @map("secondary_specializations")
  experienceLevel     String?                    @map("experience_level")
  employmentType      String?                    @map("employment_type")
  headline            String?
  skills              String[]                   @default([])
  availability        EngineerAvailabilityStatus @default(AVAILABLE)
  weeklyCapacityHours Decimal                    @default(40) @map("weekly_capacity_hours") @db.Decimal(5, 2)
  timezone            String                     @default("UTC")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  structuredSkills EngineerSkill[]
  weeklySchedule EngineerWeeklySchedule[]

  @@map("engineer_profiles")
}

enum EngineerSkillCategory {
  FRONTEND
  BACKEND
  MOBILE
  DEVOPS
  DESIGN
  QA
  DATABASE
  SECURITY
  ARCHITECTURE
  OTHER
}

enum EngineerSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model EngineerSkill {
  id              String                @id @default(cuid())
  userId          String                @map("user_id")
  category        EngineerSkillCategory
  name            String
  level           EngineerSkillLevel
  experienceYears Decimal               @map("experience_years") @db.Decimal(4, 1)
  isPrimary       Boolean               @default(false) @map("is_primary")
  createdAt       DateTime              @default(now()) @map("created_at")
