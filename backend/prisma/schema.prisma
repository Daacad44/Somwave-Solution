  githubRepositoryId String?           @map("github_repository_id")
  hostingProvider    String?           @map("hosting_provider")
  currentVersion     String?           @map("current_version")
  assignedEngineerId String?           @map("assigned_engineer_id")
  maintenanceStatus  MaintenanceStatus @default(ACTIVE) @map("maintenance_status")
