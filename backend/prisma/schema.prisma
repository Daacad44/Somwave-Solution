// Prisma schema (SYSTEM_PROMPT §4, §7). Single default-location file so
// `prisma migrate deploy` reliably discovers prisma/migrations. The per-domain
// split (core/web/portal/hr/finance/crm/pm, §6) will return via prisma.config.ts
// once we move off the deprecated package.json#prisma config (Prisma 7).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core: identity, RBAC, sessions ───────────────────────────────────────────
// Standard fields: id (cuid), createdAt, updatedAt. deletedAt where history
// matters. Table names are snake_case plural.

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  name             String
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")
  isActive         Boolean   @default(true) @map("is_active")
  // 2FA is mandatory for privileged roles (§13); the secret is set on enrolment.
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  // Owner links for portal/staff users — wired to Client/Employee in later phases.
  clientId         String?   @map("client_id")
  employeeId       String?   @map("employee_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles                         UserRole[]
  refreshTokens                 RefreshToken[]
  managedProjects               Project[]                @relation("ProjectManager")
  assignedTasks                 Task[]                   @relation("TaskAssignee")
  assignedTickets               SupportTicket[]          @relation("TicketAssignee")
  ticketReplies                 TicketReply[]            @relation("TicketReplyAuthor")
  recordedPayments              Payment[]                @relation("PaymentRecorder")
  passwordResets                PasswordResetToken[]
  backupCodes                   TwoFactorBackupCode[]
  mediaAssets                   MediaAsset[]
  documents                     ClientDocument[]         @relation("DocumentUploader")
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  projectMemberships            ProjectMember[]
  projectInvitations            ProjectInvitation[]
  ownedDocumentation            ProjectDocumentation[]   @relation("DocumentationOwner")
  createdDocumentation          ProjectDocumentation[]   @relation("DocumentationCreator")
  updatedDocumentation          ProjectDocumentation[]   @relation("DocumentationUpdater")
  approvedDocumentation         ProjectDocumentation[]   @relation("DocumentationApprover")
  ownedMilestones                Milestone[]              @relation("MilestoneOwner")
  verifiedMilestones             Milestone[]              @relation("MilestoneVerifier")
  documentationVersions         DocumentationVersion[]
  documentationComments         DocumentationComment[]
  approvedDocumentationVersions DocumentationVersion[]   @relation("DocumentationVersionApprover")
  reportedTasks                 Task[]                   @relation("TaskReporter")
  reviewedTasks                 Task[]                   @relation("TaskReviewer")
  taskComments                  TaskComment[]
  taskTimeEntries               TaskTimeEntry[]
  activeTaskTimers               EngineerTaskTimer[]
  timeEntryCorrections           TaskTimeEntryRevision[]
  engineerProgressReports        EngineerProgressReport[] @relation("EngineerProgressReportAuthor")
  reviewedEngineerReports        EngineerProgressReport[] @relation("EngineerProgressReportReviewer")
  taskReviewsAuthored           TaskReview[]             @relation("TaskReviewAuthor")
  taskReviewsGiven              TaskReview[]             @relation("TaskReviewReviewer")
  taskProgressReports           TaskProgressReport[]
  taskTransitions               TaskTransition[]
  verifiedTasks                 Task[]                   @relation("TaskQaVerifier")
  approvedSystemUpdates         SystemUpdate[]           @relation("SystemUpdateProductionApprover")
  assignedSystems               ManagedSystem[]
  assignedBugs                  BugReport[]
  assignedMaintenance           MaintenanceRequest[]
  githubInstallations           GitHubInstallation[]
  ownedReleases                 Release[]                @relation("ReleaseOwner")
  approvedReleases              Release[]                @relation("ReleaseApprover")
  engineerProfile               EngineerProfile?
  engineerAccountInvitation      EngineerAccountInvitation?
  projectInquiries               ProjectInquiry[]
  availabilitySlots             EngineerAvailability[]
  client                        Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employee                      Employee?

  @@index([clientId])
  @@index([employeeId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  // Only the hash is stored, never the raw token.
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  mfaVerifiedAt       DateTime? @map("mfa_verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  codeHash String? @map("code_hash")
  attempts Int @default(0)
  verifiedAt DateTime? @map("verified_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model MediaAsset {
  id               String   @id @default(cuid())
  storageKey       String   @unique @map("storage_key")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  alt              String?
  collection       String?
  /// imagekit | s3 | filesystem | memory. Null on rows created before ImageKit.
  provider         String?
  /// ImageKit fileId, required to replace or delete the remote file.
  providerFileId   String?  @unique @map("provider_file_id")
  /// Public CDN URL. Null for private files, which are served through authorised routes.
  url              String?
  width            Int?
  height           Int?
  /// Server-chosen ImageKit folder, e.g. somwave/website/articles.
  folder           String?
  /// Key the row used before an ImageKit migration, kept so it can be rolled back.
  legacyStorageKey String?  @map("legacy_storage_key")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([collection])
  @@index([provider])
  @@map("media_assets")
}

model ClientDocument {
  id          String    @id @default(cuid())
  title       String
  storageKey  String    @unique @map("storage_key")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  clientId    String?   @map("client_id")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("DocumentUploader", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("client_documents")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  channel        String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  sentAt         DateTime? @map("sent_at")
  providerMessageId String? @map("provider_message_id")
  error          String?
  dedupeKey      String?   @unique @map("dedupe_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventKey  String   @map("event_key")
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId])
  @@map("notification_preferences")
}

// ── Website (web.prisma domain, §7) ──────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String?
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("services")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

model JobOpening {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  location       String
  employmentType EmploymentType @map("employment_type")
  summary        String
  description    String
  isPublished    Boolean        @default(true) @map("is_published")
  publishedAt    DateTime?      @map("published_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  applications JobApplication[]

  @@index([isPublished])
  @@map("job_openings")
}

// Applications from the website careers page. These feed Internal recruitment (I3.5).
model JobApplication {
  id           String            @id @default(cuid())
  jobOpeningId String            @map("job_opening_id")
  name         String
  email        String
  phone        String?
  coverLetter  String?           @map("cover_letter")
  resumeUrl    String?           @map("resume_url")
  status       ApplicationStatus @default(NEW)
  createdAt    DateTime          @default(now()) @map("created_at")

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId, status])
  @@map("job_applications")
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]

  @@map("categories")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  coverImage  String?   @map("cover_image")
  // Display name only. Draft vs public is `isPublished`, not a second status column.
  authorName  String?   @map("author_name")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  categoryId  String?   @map("category_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

enum PortfolioCategory {
  WEBSITE
  MOBILE_APP
  CUSTOM_SOFTWARE
}

model PortfolioItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  description String?
  client      String?
  category    PortfolioCategory?
  coverImage  String?   @map("cover_image")
  technologies String[] @default([])
  galleryImages String[] @default([]) @map("gallery_images")
  features String[] @default([])
  completionDate DateTime? @map("completion_date")
  projectStatus String? @map("project_status")
  liveDemoUrl String? @map("live_demo_url")
  caseStudyUrl String? @map("case_study_url")
  featured Boolean @default(false)
  demoClicks Int @default(0) @map("demo_clicks")
  isArchived Boolean @default(false) @map("is_archived")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  order       Int       @default(0)
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  projectInquiries ProjectInquiry[]

  @@index([isPublished, order])
  @@map("portfolio_items")
}

enum ProjectInquiryStatus {
  PENDING_VERIFICATION
  EMAIL_VERIFIED
  ACCOUNT_CREATED
  UNDER_REVIEW
  PROPOSAL_SENT
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

// Public project requests are separate from generic contact enquiries and
// never become internal projects without an authorized approval and conversion.
model ProjectInquiry {
  id String @id @default(cuid())
  idempotencyKey String @unique @map("idempotency_key")
  name String
  email String
  phone String?
  companyName String? @map("company_name")
  projectType String @map("project_type")
  portfolioItemId String? @map("portfolio_item_id")
  description String
  desiredFeatures String[] @default([]) @map("desired_features")
  estimatedBudget String? @map("estimated_budget")
  expectedTimeline String? @map("expected_timeline")
  status ProjectInquiryStatus @default(PENDING_VERIFICATION)
  verificationCodeHash String? @map("verification_code_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verificationAttempts Int @default(0) @map("verification_attempts")
  verificationSends Int @default(0) @map("verification_sends")
  verificationSentAt DateTime? @map("verification_sent_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  activationTokenHash String? @map("activation_token_hash")
  activationExpiresAt DateTime? @map("activation_expires_at")
  userId String? @map("user_id")
  clientId String? @map("client_id")
  projectId String? @unique @map("project_id")
  proposalSummary String? @map("proposal_summary")
  attachmentCount Int @default(0) @map("attachment_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attachments ProjectInquiryAttachment[]

  @@index([email, createdAt])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@map("project_inquiries")
}

model ProjectInquiryAttachment {
  id String @id @default(cuid())
  inquiryId String @map("inquiry_id")
  storageKey String @unique @map("storage_key")
  contentHash String @map("content_hash")
  fileName String @map("file_name")
  mimeType String @map("mime_type")
  sizeBytes Int @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  inquiry ProjectInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@unique([inquiryId, contentHash])
  @@map("project_inquiry_attachments")
}

// Website enquiries. These become CRM leads in Internal (I5.1).
model Inquiry {
  id                String        @id @default(cuid())
  name              String
  email             String
  phone             String?
  message           String
  status            InquiryStatus @default(NEW)
  convertedClientId String?       @map("converted_client_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  convertedClient Client? @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([convertedClientId])
  @@map("inquiries")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id          String       @id @default(cuid())
  companyName String       @map("company_name")
  email       String?
  phone       String?
  status      ClientStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  users     User[]
  projects  Project[]
  invoices  Invoice[]
  tickets   SupportTicket[]
  documents ClientDocument[]
  inquiries Inquiry[]
  projectInquiries ProjectInquiry[]
  managedSystems ManagedSystem[]
  financeTransactions FinanceTransaction[]

  @@index([status])
  @@map("clients")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id         String         @id @default(cuid())
  userId     String         @unique @map("user_id")
  employeeNo String         @unique @map("employee_no")
  position   String?
  department String?
  status     EmployeeStatus @default(ACTIVE)
  hiredAt    DateTime?      @map("hired_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timesheets    Timesheet[]
  attendance    Attendance[]
  leaveRequests LeaveRequest[]

  @@map("employees")
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  date       DateTime  @db.Date
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String      @map("employee_id")
  type            LeaveType
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime    @map("end_date") @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("leave_requests")
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

model Timesheet {
  id         String          @id @default(cuid())
  employeeId String          @map("employee_id")
  projectId  String?         @map("project_id")
  date       DateTime
  hours      Decimal         @db.Decimal(5, 2)
  isBillable Boolean         @default(true) @map("is_billable")
  note       String?
  status     TimesheetStatus @default(PENDING)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([projectId])
  @@map("timesheets")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  clientId   String        @map("client_id")
  projectId  String?       @map("project_id")
  issueDate  DateTime      @map("issue_date")
  dueDate    DateTime      @map("due_date")
  subtotal   Decimal       @db.Decimal(12, 2)
  tax        Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  paidAmount Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId, status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  BANK_TRANSFER
  EVC_PLUS
  EDAHAB
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String        @map("invoice_id")
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  reference      String?
  gatewayRef     String?       @map("gateway_ref")
  payerPhone     String?       @map("payer_phone")
  recordedById   String?       @map("recorded_by_id")
  idempotencyKey String        @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([gatewayRef])
  @@map("payments")
}

// Finance ledger is additive. Legacy invoices/payments/project expenses are not
// silently posted here: historical recognition and settlement require review.
enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  DIRECT_COST
  EXPENSE
}

enum FinancePeriodStatus {
  OPEN
  CLOSED
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum FinanceTransactionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

model FinanceAccount {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  type         FinanceAccountType
  currency     String?
  isActive     Boolean            @default(true) @map("is_active")
  allowPosting Boolean            @default(true) @map("allow_posting")
  parentId     String?            @map("parent_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  parent   FinanceAccount?  @relation("FinanceAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children FinanceAccount[] @relation("FinanceAccountHierarchy")
  lines    FinanceJournalLine[]
  cashTransactions FinanceTransaction[] @relation("FinanceCashAccount")
  offsetTransactions FinanceTransaction[] @relation("FinanceOffsetAccount")

  @@index([type, isActive])
  @@map("finance_accounts")
}

model FinancePeriod {
  id          String              @id @default(cuid())
  year        Int
  month       Int
  status      FinancePeriodStatus @default(OPEN)
  closedById  String?             @map("closed_by_id")
  closedAt    DateTime?           @map("closed_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([year, month])
  @@map("finance_periods")
}

model FinanceJournal {
  id                String               @id @default(cuid())
  reference         String               @unique
  occurredOn        DateTime             @map("occurred_on")
  currency          String
  memo              String
  sourceType        String?              @map("source_type")
  sourceId          String?              @map("source_id")
  reversesJournalId String?              @unique @map("reverses_journal_id")
  createdById       String               @map("created_by_id")
  postedAt          DateTime             @default(now()) @map("posted_at")
  isFinalized       Boolean              @default(false) @map("is_finalized")

  lines      FinanceJournalLine[]
  reverses   FinanceJournal?      @relation("FinanceJournalReversal", fields: [reversesJournalId], references: [id], onDelete: Restrict)
  reversedBy FinanceJournal?      @relation("FinanceJournalReversal")
  transaction FinanceTransaction?

  @@unique([sourceType, sourceId])
  @@index([occurredOn, currency])
  @@map("finance_journals")
}

model FinanceJournalLine {
  id        String  @id @default(cuid())
  journalId String  @map("journal_id")
  accountId String  @map("account_id")
  debit     Decimal @default(0) @db.Decimal(20, 2)
  credit    Decimal @default(0) @db.Decimal(20, 2)
  projectId String? @map("project_id")
  clientId  String? @map("client_id")

  journal FinanceJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([projectId])
  @@map("finance_journal_lines")
}

model FinanceTransaction {
  id              String                   @id @default(cuid())
  type            FinanceTransactionType
  status          FinanceTransactionStatus @default(DRAFT)
  amount          Decimal                  @db.Decimal(20, 2)
  currency        String
  category        String
  description     String
  occurredOn      DateTime                 @map("occurred_on")
  paymentMethod   String?                  @map("payment_method")
  externalRef     String?                  @map("external_ref")
  projectId       String?                  @map("project_id")
  clientId        String?                  @map("client_id")
  counterparty    String?
  cashAccountId   String                   @map("cash_account_id")
  offsetAccountId String                   @map("offset_account_id")
  createdById     String                   @map("created_by_id")
  reviewedById    String?                  @map("reviewed_by_id")
  reviewReason    String?                  @map("review_reason")
  reviewedAt      DateTime?                @map("reviewed_at")
  postedJournalId String?                  @unique @map("posted_journal_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  cashAccount FinanceAccount @relation("FinanceCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  offsetAccount FinanceAccount @relation("FinanceOffsetAccount", fields: [offsetAccountId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  postedJournal FinanceJournal? @relation(fields: [postedJournalId], references: [id], onDelete: Restrict)

  @@index([status, occurredOn])
  @@unique([type, externalRef])
  @@index([projectId])
  @@index([clientId])
  @@map("finance_transactions")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String         @id @default(cuid())
  code        String         @unique
  clientId    String         @map("client_id")
  projectId   String?        @map("project_id")
  assigneeId  String?        @map("assignee_id")
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  replies  TicketReply[]

  @@index([clientId, status])
  @@index([assigneeId])
  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("TicketReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_replies")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id")
  actorId     String?  @map("actor_id")
  correlationId String? @map("correlation_id")
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([correlationId])
  @@map("audit_logs")
}

// ── Domain event outbox (I8.0) ───────────────────────────────────────────────
// Written in the same transaction as the business change (emitEvent). The worker
// relay publishes PENDING rows to BullMQ; handlers dedupe on DomainEventHandling.
enum DomainEventStatus {
  PENDING
  PUBLISHED
  PROCESSED
  FAILED
}

model DomainEvent {
  id          String            @id @default(cuid())
  type        String
  aggregateId String            @map("aggregate_id")
  projectId   String?           @map("project_id")
  payload     Json
  status      DomainEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  publishedAt DateTime?         @map("published_at")
  processedAt DateTime?         @map("processed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  handlings DomainEventHandling[]

  @@index([publishedAt, createdAt])
  @@index([status, createdAt])
  @@index([type, aggregateId])
  @@index([projectId])
  @@map("domain_events")
}

// One row per (event, handler) that completed, written in the handler's own
// transaction, so a retried or replayed event never runs a handler twice.
model DomainEventHandling {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  handler   String
  handledAt DateTime @default(now()) @map("handled_at")

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, handler])
  @@map("domain_event_handlings")
}

model Setting {
  id        String   @id @default(cuid())
  group     String
  key       String
  value     Json
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([group, key])
  @@map("settings")
}

// ── Project management (pm.prisma domain, §7) ────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Projects originate in Internal (I2.1); the Portal reads them (Gate 1). clientId
// is a nullable owner link wired to Client in P1, mirroring User.clientId (§7).
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  healthNote  String?       @map("health_note")
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  budget      Decimal?      @db.Decimal(12, 2)
  clientId    String?       @map("client_id")
  managerId   String?       @map("manager_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  manager             User?                  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  client              Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks               Task[]
  milestones          Milestone[]
  timesheets          Timesheet[]
  invoices            Invoice[]
  tickets             SupportTicket[]
  members             ProjectMember[]
  invitations         ProjectInvitation[]
  documentation       ProjectDocumentation[]
  managedSystems      ManagedSystem[]
  systemUpdates       SystemUpdate[]
  releases            Release[]
  bugs                BugReport[]
  maintenanceRequests MaintenanceRequest[]
  githubRepositories  GitHubRepository[]
  phases              ProjectPhase[]
  engineerReports     EngineerProgressReport[]
  expenses            ProjectExpense[]
  budgetRevisions     ProjectBudgetRevision[]
  financeTransactions FinanceTransaction[]
  originatingInquiry ProjectInquiry?

  @@index([clientId])
  @@index([status])
  @@index([managerId])
  @@map("projects")
}

enum ProjectExpenseKind {
  PLANNED
  ACTUAL
}

model ProjectExpense {
  id          String             @id @default(cuid())
  projectId   String             @map("project_id")
  kind        ProjectExpenseKind
  category    String
  description String
  amount      Decimal            @db.Decimal(12, 2)
  expenseDate DateTime?          @map("expense_date")
  actorId     String             @map("actor_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  deletedAt   DateTime?          @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt, kind])
  @@map("project_expenses")
}

model ProjectBudgetRevision {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  previousBudget Decimal? @map("previous_budget") @db.Decimal(12, 2)
  newBudget      Decimal  @map("new_budget") @db.Decimal(12, 2)
  reason         String
  actorId        String   @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_budget_revisions")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Milestones belong to a project (the owner key, §7). The Portal reads them (P2.3).
model Milestone {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  clientVisible Boolean       @default(false) @map("client_visible")
  ownerId     String?         @map("owner_id")
  verifiedById String?        @map("verified_by_id")
  verifiedAt  DateTime?       @map("verified_at")
  dueDate     DateTime?       @map("due_date")
  completedAt DateTime?       @map("completed_at")
  order       Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner         User?                   @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifiedBy    User?                   @relation("MilestoneVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  tasks         Task[]
  documentLinks DocumentMilestoneLink[]
  prerequisites MilestoneDependency[] @relation("MilestonePrerequisites")
  dependents    MilestoneDependency[] @relation("MilestoneDependents")

  @@index([projectId, status])
  @@index([ownerId])
  @@map("milestones")
}

model MilestoneDependency {
  id          String    @id @default(cuid())
  milestoneId String    @map("milestone_id")
  dependsOnId String    @map("depends_on_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  milestone   Milestone @relation("MilestonePrerequisites", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOn   Milestone @relation("MilestoneDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, dependsOnId])
  @@index([dependsOnId])
  @@map("milestone_dependencies")
}

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  order       Int       @default(0)
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
  @@map("project_phases")
}

enum TaskKind {
  EPIC
  TASK
  SUBTASK
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  TESTING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FEATURE
  BUG_FIX
  IMPROVEMENT
  RESEARCH
  DESIGN
  TESTING
  DOCUMENTATION
  MAINTENANCE
  OTHER
}

enum TaskApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// Tasks belong to a project (the owner key, §7). assigneeId links to a staff User.
model Task {
  id                 String             @id @default(cuid())
  code               String?            @unique
  projectId          String             @map("project_id")
  title              String
  description        String?
  type               TaskType           @default(FEATURE)
  kind               TaskKind           @default(TASK)
  status             TaskStatus         @default(TODO)
  priority           TaskPriority       @default(MEDIUM)
  assigneeId         String?            @map("assignee_id")
  reporterId         String?            @map("reporter_id")
  milestoneId        String?            @map("milestone_id")
  parentTaskId       String?            @map("parent_task_id")
  phaseId            String?            @map("phase_id")
  progressPercent    Int                @default(0) @map("progress_percent")
  blockedReason      String?            @map("blocked_reason")
  completedAt        DateTime?          @map("completed_at")
  qaVerifiedById     String?            @map("qa_verified_by_id")
  qaVerifiedAt       DateTime?          @map("qa_verified_at")
  startDate          DateTime?          @map("start_date")
  dueDate            DateTime?          @map("due_date")
  estimatedHours     Decimal?           @map("estimated_hours") @db.Decimal(8, 2)
  acceptanceCriteria String?            @map("acceptance_criteria")
  reviewRequired     Boolean            @default(true) @map("review_required")
  approvalStatus     TaskApprovalStatus @default(DRAFT) @map("approval_status")
  submittedAt        DateTime?          @map("submitted_at")
  reviewedById       String?            @map("reviewed_by_id")
  reviewedAt         DateTime?          @map("reviewed_at")
  reviewNote         String?            @map("review_note")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter        User?                @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer        User?                @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  milestone       Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  phase           ProjectPhase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  qaVerifiedBy    User?                @relation("TaskQaVerifier", fields: [qaVerifiedById], references: [id], onDelete: SetNull)
  parentTask      Task?                @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks        Task[]               @relation("TaskSubtasks")
  dependencies    TaskDependency[]     @relation("TaskDependencyTask")
  dependents      TaskDependency[]     @relation("TaskDependencyPrerequisite")
  comments        TaskComment[]
  attachments     TaskAttachment[]
  timeEntries     TaskTimeEntry[]
  timers          EngineerTaskTimer[]
  reviews         TaskReview[]
  checklist       TaskChecklistItem[]
  progressReports TaskProgressReport[]
  transitions     TaskTransition[]
  documentLinks   DocumentTaskLink[]
  githubLinks     GitHubTaskLink[]
  updateLinks     SystemUpdateTask[]
  releaseLinks    ReleaseTask[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
  @@index([parentTaskId])
  @@index([phaseId])
  @@index([reporterId])
  @@map("tasks")
}

enum ProjectMemberRole {
  MANAGER
  LEAD_ENGINEER
  ENGINEER
  REVIEWER
  QA_ENGINEER
  CONTRIBUTOR
  VIEWER
}

model ProjectMember {
  id               String            @id @default(cuid())
  projectId        String            @map("project_id")
  userId           String            @map("user_id")
  role             ProjectMemberRole @default(ENGINEER)
  responsibilities String?
  description      String?
  startDate        DateTime?         @map("start_date")
  expectedEndDate  DateTime?         @map("expected_end_date")
  estimatedHours   Decimal?          @map("estimated_hours") @db.Decimal(8, 2)
  priority         TaskPriority      @default(MEDIUM)
  managerNotes     String?           @map("manager_notes")
  assignedAt       DateTime          @default(now()) @map("assigned_at")
  removedAt        DateTime?         @map("removed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, removedAt])
  @@map("project_members")
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model ProjectInvitation {
  id               String                  @id @default(cuid())
  projectId        String                  @map("project_id")
  userId           String                  @map("user_id")
  role             ProjectMemberRole
  responsibilities String?
  description      String?
  startDate        DateTime?               @map("start_date")
  expectedEndDate  DateTime?               @map("expected_end_date")
  estimatedHours   Decimal?                @map("estimated_hours") @db.Decimal(8, 2)
  priority         TaskPriority            @default(MEDIUM)
  managerNotes     String?                 @map("manager_notes")
  status           ProjectInvitationStatus @default(PENDING)
  invitedAt        DateTime                @default(now()) @map("invited_at")
  expiresAt        DateTime?               @map("expires_at")
  respondedAt      DateTime?               @map("responded_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("project_invitations")
}

enum EngineerAvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum EngineerAccountStatus {
  INVITED
  PENDING_VERIFICATION
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EngineerInvitationStatus {
  INVITED
  VERIFIED
  ACTIVATED
  CANCELLED
}

model EngineerAccountInvitation {
  id                  String                   @id @default(cuid())
  userId              String                   @unique @map("user_id")
  invitedById         String                   @map("invited_by_id")
  wasExistingUser     Boolean                  @default(false) @map("was_existing_user")
  tokenHash           String                   @unique @map("token_hash")
  activationTokenHash String?                  @unique @map("activation_token_hash")
  expiresAt           DateTime                 @map("expires_at")
  activationExpiresAt DateTime?                @map("activation_expires_at")
  verifiedAt          DateTime?                @map("verified_at")
  activatedAt         DateTime?                @map("activated_at")
  lastSentAt          DateTime?                @map("last_sent_at")
  sendCount           Int                      @default(0) @map("send_count")
  deliveryStatus      String                   @default("PENDING") @map("delivery_status")
