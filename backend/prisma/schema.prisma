// Prisma schema (SYSTEM_PROMPT §4, §7). Single default-location file so
// `prisma migrate deploy` reliably discovers prisma/migrations. The per-domain
// split (core/web/portal/hr/finance/crm/pm, §6) will return via prisma.config.ts
// once we move off the deprecated package.json#prisma config (Prisma 7).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core: identity, RBAC, sessions ───────────────────────────────────────────
// Standard fields: id (cuid), createdAt, updatedAt. deletedAt where history
// matters. Table names are snake_case plural.

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  name             String
  isActive         Boolean   @default(true) @map("is_active")
  // 2FA is mandatory for privileged roles (§13); the secret is set on enrolment.
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  // Owner links for portal/staff users — wired to Client/Employee in later phases.
  clientId         String?   @map("client_id")
  employeeId       String?   @map("employee_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@index([clientId])
  @@index([employeeId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  // Only the hash is stored, never the raw token.
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Website (web.prisma domain, §7) ──────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String?
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("services")
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

model PortfolioItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  description String?
  client      String?
  coverImage  String?   @map("cover_image")
  order       Int       @default(0)
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("portfolio_items")
}

// Website enquiries. These become CRM leads in Internal (I5.1).
model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("inquiries")
}
