// Prisma schema (SYSTEM_PROMPT §4, §7). Single default-location file so
// `prisma migrate deploy` reliably discovers prisma/migrations. The per-domain
// split (core/web/portal/hr/finance/crm/pm, §6) will return via prisma.config.ts
// once we move off the deprecated package.json#prisma config (Prisma 7).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core: identity, RBAC, sessions ───────────────────────────────────────────
// Standard fields: id (cuid), createdAt, updatedAt. deletedAt where history
// matters. Table names are snake_case plural.

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  name             String
  isActive         Boolean   @default(true) @map("is_active")
  // 2FA is mandatory for privileged roles (§13); the secret is set on enrolment.
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  // Owner links for portal/staff users — wired to Client/Employee in later phases.
  clientId         String?   @map("client_id")
  employeeId       String?   @map("employee_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  managedProjects Project[]      @relation("ProjectManager")
  assignedTasks   Task[]         @relation("TaskAssignee")

  @@index([clientId])
  @@index([employeeId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  // Only the hash is stored, never the raw token.
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Website (web.prisma domain, §7) ──────────────────────────────────────────

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String?
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("services")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

model JobOpening {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  location       String
  employmentType EmploymentType @map("employment_type")
  summary        String
  description    String
  isPublished    Boolean        @default(true) @map("is_published")
  publishedAt    DateTime?      @map("published_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  applications JobApplication[]

  @@index([isPublished])
  @@map("job_openings")
}

// Applications from the website careers page. These feed Internal recruitment (I3.5).
model JobApplication {
  id           String            @id @default(cuid())
  jobOpeningId String            @map("job_opening_id")
  name         String
  email        String
  phone        String?
  coverLetter  String?           @map("cover_letter")
  resumeUrl    String?           @map("resume_url")
  status       ApplicationStatus @default(NEW)
  createdAt    DateTime          @default(now()) @map("created_at")

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId, status])
  @@map("job_applications")
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]

  @@map("categories")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  categoryId  String?   @map("category_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

model PortfolioItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  description String?
  client      String?
  coverImage  String?   @map("cover_image")
  order       Int       @default(0)
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("portfolio_items")
}

// Website enquiries. These become CRM leads in Internal (I5.1).
model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("inquiries")
}

// ── Project management (pm.prisma domain, §7) ────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Projects originate in Internal (I2.1); the Portal reads them (Gate 1). clientId
// is a nullable owner link wired to Client in P1, mirroring User.clientId (§7).
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  budget      Decimal?      @db.Decimal(12, 2)
  clientId    String?       @map("client_id")
  managerId   String?       @map("manager_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  manager    User?       @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  tasks      Task[]
  milestones Milestone[]

  @@index([clientId])
  @@index([status])
  @@index([managerId])
  @@map("projects")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Milestones belong to a project (the owner key, §7). The Portal reads them (P2.3).
model Milestone {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?       @map("due_date")
  completedAt DateTime?       @map("completed_at")
  order       Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Tasks belong to a project (the owner key, §7). assigneeId links to a staff User.
model Task {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id")
  dueDate     DateTime?    @map("due_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

// ── Website: social proof (web.prisma domain, §7) ────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  author      String
  role        String?
  company     String?
  quote       String
  avatarUrl   String?  @map("avatar_url")
  rating      Int?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("testimonials")
}

// ── Website: team (web.prisma domain, §7) ────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String?
  photoUrl    String?  @map("photo_url")
  linkedinUrl String?  @map("linkedin_url")
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, order])
  @@map("team_members")
}
