  userId      String   @map("user_id")
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile EngineerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, weekday, startMinute])
  @@index([userId, weekday])
  @@map("engineer_weekly_schedule")
}

model EngineerAvailability {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  kind      String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt, endAt])
  @@map("engineer_availability")
