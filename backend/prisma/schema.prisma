  ASSIGNED
  IN_PROGRESS
  CODE_REVIEW
  TESTING
  RESOLVED
  CLOSED
  REOPENED
}

model BugReport {
  id                String       @id @default(cuid())
  code              String?      @unique
  systemId          String       @map("system_id")
  projectId         String       @map("project_id")
  title             String
  description       String
