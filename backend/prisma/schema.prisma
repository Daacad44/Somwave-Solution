  BUG_FIX
  PERFORMANCE_OPTIMIZATION
  UI_UX_UPDATE
  DATABASE_MIGRATION
  DEPENDENCY_UPGRADE
  INFRASTRUCTURE_CHANGE
}

enum SystemUpdateStatus {
  REQUESTED
  APPROVED
  ASSIGNED
  IN_DEVELOPMENT
  CODE_REVIEW
  TESTING
  STAGING
  PRODUCTION_APPROVAL
  DEPLOYED
  VERIFIED
  COMPLETED
  CANCELLED
