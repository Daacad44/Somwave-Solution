---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';

// Static marketing content for the homepage. The data-driven services, portfolio,
// and blog sections wire the public API in W2+ (not mock data — genuinely static
// copy here).
const services = [
  {
    title: 'Horumarinta Websaydka',
    description:
      'Website-yo dhaqso ah oo naqshadeysan, ku habboon mobil iyo kombuyuutar, oo Google si fiican u arko.',
  },
  {
    title: 'Nidaamyo Gudaha ah',
    description:
      'Nidaamyo maamul oo mashruuc, shaqaale, iyo maaliyad hal meel isugu keena — Excel iyo WhatsApp ka bax.',
  },
  {
    title: 'Barnaamijyo Mobil',
    description:
      'Apps iOS iyo Android ah oo isku xiran API-gaaga, adeeggaaga macaamiisha kuu fududeeya.',
  },
];

const steps = [
  { title: 'Fahan', description: 'Waxaan bartaa baahidaada iyo yoolalka ganacsigaaga.' },
  { title: 'Naqshad', description: 'Waxaan sameynaa naqshad iyo qorshe cad oo aad aragto.' },
  { title: 'Dhis', description: 'Waxaan ku dhisnaa teknoolajiyad casri ah oo lagu kalsoonaan karo.' },
  { title: 'Taageero', description: 'Ka dib bilawga, waan ku ilaalinaa oo horumarinaa.' },
];
---

<PageLayout
  title="Somwave — Xalal Dijital ah"
  description="Somwave waxay dhistaa website-yo, nidaamyo gudaha ah, iyo barnaamijyo mobil oo ganacsigaaga horumariya."
>
  <Hero />

  <!-- Adeegyada -->
  <section id="adeegyada" class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Adeegyada</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink">Waxa aan kuu qaban karno</h2>
      <p class="mt-3 text-lg text-muted">
        Saddex adeeg oo aasaasi ah oo ganacsiyada Soomaaliyeed u baahan yihiin si ay online ugu
        koraan.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard title={service.title} description={service.description} />)}
    </div>
  </section>

  <!-- Habka shaqada -->
  <section id="habka-shaqada" class="bg-surface-alt">
    <div class="mx-auto max-w-content px-4 py-20 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Habka shaqada</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink">Afar tallaabo oo cad</h2>
      </div>

      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, index) => (
            <li class="rounded-lg border border-border bg-surface p-6">
              <span class="text-sm font-bold text-accent-600">
                0{index + 1}
              </span>
              <h3 class="mt-2 text-lg font-semibold text-ink">{step.title}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-muted">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <div class="rounded-lg bg-primary px-8 py-14 text-center text-surface md:px-16">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        Ma diyaar u tahay inaad bilowdo mashruucaaga?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-surface/80">
        Nala soo xiriir maanta — waxaan kaa caawinaynaa inaad fikradaada u beddesho xal dhab ah.
      </p>
      <a
        href="/nala-soo-xiriir"
        class="mt-8 inline-flex h-12 items-center rounded-md bg-accent px-8 text-base font-semibold text-primary transition-colors hover:bg-accent-600"
      >
        Nala soo xiriir
      </a>
    </div>
  </section>
</PageLayout>
