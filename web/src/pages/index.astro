---
// SSR so the latest published articles are read on each request, not baked in
// at build time. Other sections stay the existing static markup.
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import { markCmsPageFresh } from '../lib/publicCache';
import { fetchHomepage } from '../lib/api';
import { defaultSiteContent, type PublicHomepage } from '@somwave/shared';
import Hero from '../components/Hero.astro';
import TrustedLogos from '../components/home/TrustedLogos.astro';
import HomeIntroduction from '../components/home/HomeIntroduction.astro';
import HomeProcess from '../components/home/HomeProcess.astro';
import HomeContact from '../components/home/HomeContact.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeSolutions from '../components/home/HomeSolutions.astro';
import WhySomwave from '../components/home/WhySomwave.astro';
import HomePortfolio from '../components/home/HomePortfolio.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeArticles from '../components/home/HomeArticles.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import FinalCta from '../components/home/FinalCta.astro';

markCmsPageFresh(Astro.response.headers);
let homepage: PublicHomepage = { siteContent: defaultSiteContent, services: null, portfolio: null, testimonials: null, posts: null, faqs: null };
try {
  homepage = await fetchHomepage();
} catch {
  // Keep the verified defaults when the CMS is temporarily unavailable.
}
const siteContent = homepage.siteContent;
const firstId = siteContent.heroSlideOrder[0];
const firstSlide = firstId === 'intro' ? siteContent.hero : siteContent.heroSlides.find((slide) => slide.id === firstId);
const firstImage = firstSlide?.imageUrl === '/images/hero-somwave.png' ? '/images/hero-devices-1200.webp' : firstSlide?.imageUrl;
const defaultDevices = firstImage === '/images/hero-devices-1200.webp';
---

<PageLayout
  title="Somwave Solution — Technology for what comes next"
  description="Somwave Solution builds websites, mobile apps, custom software, and digital tools for growing businesses."
  siteContent={siteContent}
  homepage
  preloadImage={firstImage || undefined}
  preloadImageSrcset={defaultDevices ? '/images/hero-devices-768.webp 768w, /images/hero-devices-1200.webp 1200w' : undefined}
>
  <Hero content={siteContent} />
  <TrustedLogos content={siteContent.trusted} />
  <HomeIntroduction content={siteContent.hero} />
  <HomeSolutions content={siteContent.ecosystem} />
  <HomeServices services={homepage.services} />
  <HomePortfolio projects={homepage.portfolio} />
  <WhySomwave />
  <HomeProcess />
  <HomeTestimonials testimonials={homepage.testimonials} />
  <HomeArticles posts={homepage.posts} />
  <HomeFaq faqs={homepage.faqs} />
  <HomeContact contact={siteContent.contact} />
  <FinalCta content={siteContent.cta} />
</PageLayout>
