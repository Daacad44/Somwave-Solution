---
// Portfolio detail (W3.1). SSR — reads /api/v1/public/portfolio/:slug; renders a
// real 404 when the item is missing.
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import { fetchPortfolioItem } from '../../lib/api';

const { slug } = Astro.params;
const item = slug ? await fetchPortfolioItem(slug) : null;

if (!item) {
  Astro.response.status = 404;
}
---

{
  item ? (
    <PageLayout title={`${item.title} — Somwave`} description={item.summary}>
      <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
        <a href="/shaqooyinka" class="text-sm font-semibold text-accent-600">← Back to portfolio</a>
        {item.client ? (
          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.12em] text-accent-600">
            {item.client}
          </p>
        ) : null}
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">{item.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{item.summary}</p>

        {item.coverImage ? (
          <img
            src={item.coverImage}
            alt={item.title}
            class="mt-8 w-full rounded-lg border border-border object-cover"
          />
        ) : null}

        {item.description ? (
          <div class="mt-8 whitespace-pre-line text-base leading-relaxed text-ink">
            {item.description}
          </div>
        ) : null}
      </article>
    </PageLayout>
  ) : (
    <PageLayout title="Not found — Somwave" description="This page could not be found.">
      <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
        <h1 class="text-4xl font-extrabold tracking-tight text-ink">Not found</h1>
        <p class="mt-3 text-lg text-muted">This project could not be found or is no longer available.</p>
        <a
          href="/shaqooyinka"
          class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
        >
          View all projects
        </a>
      </section>
    </PageLayout>
  )
}
