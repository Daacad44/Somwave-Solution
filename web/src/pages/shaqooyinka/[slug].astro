---
// Published portfolio detail is rendered from the public CMS API on each request.
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
  import { fetchPortfolioItem } from '../../lib/api';
import { safeExternalUrl } from '../../lib/externalUrl';

const { slug } = Astro.params;
const item = slug ? await fetchPortfolioItem(slug) : null;
if (!item) Astro.response.status = 404;

const demoUrl = safeExternalUrl(item?.liveDemoUrl);
const caseStudyUrl = safeExternalUrl(item?.caseStudyUrl);
const requestUrl = item ? `/request-project?portfolio=${encodeURIComponent(item.slug)}` : '/request-project';
const categoryName = item?.category ? { WEBSITE: 'Website', MOBILE_APP: 'Mobile app', CUSTOM_SOFTWARE: 'Custom software' }[item.category] : null;
---

{item ? (
  <PageLayout title={`${item.seoTitle || item.title} — Somwave`} description={item.seoDescription || item.summary} image={item.coverImage}>
    <article>
      <header class="bg-sky/50">
        <div class="mx-auto max-w-content px-4 py-14 sm:px-6 sm:py-20">
          <a href="/shaqooyinka" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand hover:underline">← Back to portfolio</a>
          <div class="mt-7 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-wider text-brand">
            {categoryName && <span class="rounded-full bg-brand/10 px-3 py-1.5">{categoryName}</span>}
            {item.projectStatus && <span class="rounded-full bg-brand/10 px-3 py-1.5">{item.projectStatus}</span>}
          </div>
          <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-primary sm:text-6xl">{item.title}</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{item.summary}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer" data-portfolio-demo={item.id} class="inline-flex min-h-12 items-center gap-2 rounded-md bg-brand px-5 py-3 text-sm font-bold text-surface hover:bg-brand-600">View Live Demo <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
            <a href={requestUrl} class="inline-flex min-h-12 items-center rounded-md border border-brand px-5 py-3 text-sm font-bold text-brand hover:bg-brand/10">Request a Similar Project</a>
          </div>
          {!demoUrl && <p class="mt-3 text-sm text-muted">A public live demo is not available for this project.</p>}
        </div>
      </header>

      <div class="mx-auto grid max-w-content gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,2fr)_minmax(16rem,1fr)] lg:gap-16 lg:py-20">
        <div>
          {item.coverImage && <img src={item.coverImage} alt={`${item.title} project cover`} class="w-full rounded-xl border border-border object-cover shadow-sm" />}
          {item.description && <section aria-labelledby="overview-title" class="mt-10"><h2 id="overview-title" class="text-2xl font-bold text-primary">Project overview</h2><p class="mt-4 whitespace-pre-line leading-8 text-ink">{item.description}</p></section>}
          {item.features.length > 0 && <section aria-labelledby="features-title" class="mt-10"><h2 id="features-title" class="text-2xl font-bold text-primary">Key features</h2><ul class="mt-5 grid gap-3 sm:grid-cols-2">{item.features.map((feature) => <li class="rounded-lg border border-border bg-surface p-4 leading-6 text-ink">{feature}</li>)}</ul></section>}
          {item.galleryImages.length > 0 && <section aria-labelledby="gallery-title" class="mt-12"><h2 id="gallery-title" class="text-2xl font-bold text-primary">Project gallery</h2><div class="mt-5 grid gap-5 sm:grid-cols-2">{item.galleryImages.map((image, index) => <img src={image} alt={`${item.title} gallery image ${index + 1}`} loading="lazy" decoding="async" class="w-full rounded-lg border border-border object-cover" />)}</div></section>}
        </div>
        <aside aria-label="Project details" class="h-fit rounded-xl border border-border bg-surface-alt p-6">
          <h2 class="text-lg font-bold text-primary">Project details</h2>
          <dl class="mt-5 space-y-5 text-sm">
            {item.client && <div><dt class="font-semibold text-muted">Client</dt><dd class="mt-1 text-ink">{item.client}</dd></div>}
            {categoryName && <div><dt class="font-semibold text-muted">Category</dt><dd class="mt-1 text-ink">{categoryName}</dd></div>}
            {item.completionDate && <div><dt class="font-semibold text-muted">Completed</dt><dd class="mt-1 text-ink"><time datetime={item.completionDate}>{new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(item.completionDate))}</time></dd></div>}
            {item.technologies.length > 0 && <div><dt class="font-semibold text-muted">Technologies</dt><dd class="mt-2 flex flex-wrap gap-2">{item.technologies.map((technology) => <span class="rounded-full bg-brand/10 px-2.5 py-1 text-brand">{technology}</span>)}</dd></div>}
          </dl>
          {caseStudyUrl && <a href={caseStudyUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-brand hover:underline">Read case study <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
        </aside>
      </div>
    </article>
  </PageLayout>
) : (
  <PageLayout title="Not found — Somwave" description="This project could not be found.">
    <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
      <h1 class="text-4xl font-extrabold text-ink">Project not found</h1>
      <p class="mt-3 text-lg text-muted">This project could not be found or is no longer available.</p>
      <a href="/shaqooyinka" class="mt-8 inline-flex min-h-11 items-center rounded-md bg-brand px-5 py-3 text-sm font-semibold text-surface">View all projects</a>
    </section>
  </PageLayout>
)}

<script>
  import { recordPortfolioDemoClick } from '../../lib/api';
  document.querySelectorAll<HTMLAnchorElement>('[data-portfolio-demo]').forEach((link) => {
    link.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('somwave:portfolio-demo', { detail: { portfolioId: link.dataset.portfolioDemo } }));
      const id = link.dataset.portfolioDemo;
      if (id) void recordPortfolioDemoClick(id).catch(() => {});
    });
  });
</script>
