---
// Service detail (W2.3). SSR — reads /api/v1/public/services/:slug.
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import { fetchService } from '../../lib/api';
import { displayService } from '../../lib/serviceDisplay';

const { slug } = Astro.params;
const fetched = slug ? await fetchService(slug) : null;
const service = fetched ? displayService(fetched) : null;

if (!service) {
  Astro.response.status = 404;
}
---

{
  service ? (
    <PageLayout title={`${service.title} — Somwave`} description={service.summary}>
      <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
        <a href="/adeegyada" class="text-sm font-semibold text-accent-600">
          ← Back to services
        </a>
        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Service</p>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
          {service.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{service.summary}</p>
        {service.description ? (
          <div class="mt-8 whitespace-pre-line text-base leading-relaxed text-ink">
            {service.description}
          </div>
        ) : null}
        <a
          href="/nala-soo-xiriir"
          class="mt-10 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
        >
          Ask about this service
        </a>
      </article>
    </PageLayout>
  ) : (
    <PageLayout title="Not found — Somwave" description="This service could not be found.">
      <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
        <h1 class="text-4xl font-extrabold tracking-tight text-ink">Not found</h1>
        <p class="mt-3 text-lg text-muted">This service could not be found or is not published yet.</p>
        <a
          href="/adeegyada"
          class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
        >
          View all services
        </a>
      </section>
    </PageLayout>
  )
}
