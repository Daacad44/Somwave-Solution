---
// Custom 404 page (W5.5 SEO). Static — served for unknown routes.
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page not found — Somwave"
  description="This page could not be found. Return to the homepage."
>
  <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Error 404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      Page not found
    </h1>
    <p class="mx-auto mt-4 max-w-md text-lg leading-relaxed text-muted">
      The page you are looking for has moved or no longer exists. Return home or get in touch.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
      >
        Homepage
      </a>
      <a
        href="/nala-soo-xiriir"
        class="inline-flex h-11 items-center rounded-md border border-border bg-surface px-5 text-sm font-semibold text-ink hover:bg-surface-alt"
      >
        Contact us
      </a>
    </div>
  </section>
</PageLayout>
