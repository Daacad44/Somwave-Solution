---
// Data-driven services page (W2). Server-rendered on request so the list is
// always current — it reads /api/v1/public/services (SYSTEM_PROMPT §5, §10).
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { fetchServices } from '../lib/api';
import { additionalServices, displayService } from '../lib/serviceDisplay';
import type { PublicService } from '@somwave/shared';

let services: PublicService[] = [];
let failed = false;
try {
  services = (await fetchServices()).map(displayService);
} catch {
  failed = true;
}
---

<PageLayout
  title="Services — Somwave"
  description="Explore Somwave services: websites, custom systems, and mobile apps."
>
  <section class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Services</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
        What we can build for you
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Digital services that help your business grow.
      </p>
    </div>

    {
      failed ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Services are unavailable right now. Please try again later.
        </p>
      ) : services.length === 0 ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          No services have been published yet.
        </p>
      ) : (
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.summary}
              href={`/adeegyada/${service.slug}`}
            />
          ))}
          {additionalServices.filter((extra) => !services.some((service) => service.title.toLowerCase() === extra.title.toLowerCase())).map((extra) => (
            <ServiceCard title={extra.title} description={extra.summary} href="/nala-soo-xiriir" />
          ))}
        </div>
      )
    }
  </section>
</PageLayout>
