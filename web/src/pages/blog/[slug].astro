---
// Blog post detail (W3.2). SSR — reads /api/v1/public/posts/:slug; real 404 when
// the post is missing.
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import { fetchPost } from '../../lib/api';

const { slug } = Astro.params;
const post = slug ? await fetchPost(slug) : null;

if (!post) {
  Astro.response.status = 404;
}

const dateLabel = post?.publishedAt
  ? new Intl.DateTimeFormat('so', { dateStyle: 'long', timeZone: 'Africa/Mogadishu' }).format(
      new Date(post.publishedAt),
    )
  : null;
---

{
  post ? (
    <PageLayout title={`${post.title} — Somwave`} description={post.excerpt}>
      <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
        <a href="/blog" class="text-sm font-semibold text-accent-600">← Dib ugu noqo maqaallada</a>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-accent-600">
          {post.category ? <span>{post.category.name}</span> : null}
          {post.category && dateLabel ? <span class="text-border">•</span> : null}
          {dateLabel ? (
            <time class="text-muted" datetime={post.publishedAt}>
              {dateLabel}
            </time>
          ) : null}
        </div>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">{post.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{post.excerpt}</p>

        {post.coverImage ? (
          <img
            src={post.coverImage}
            alt={post.title}
            class="mt-8 w-full rounded-lg border border-border object-cover"
          />
        ) : null}

        <div class="mt-8 whitespace-pre-line text-base leading-relaxed text-ink">{post.body}</div>
      </article>
    </PageLayout>
  ) : (
    <PageLayout title="Lama helin — Somwave" description="Boggan lama helin.">
      <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
        <h1 class="text-4xl font-extrabold tracking-tight text-ink">Lama helin</h1>
        <p class="mt-3 text-lg text-muted">Maqaalkan lama helin ama waa la qaaday.</p>
        <a
          href="/blog"
          class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
        >
          Fiiri dhammaan maqaallada
        </a>
      </section>
    </PageLayout>
  )
}
