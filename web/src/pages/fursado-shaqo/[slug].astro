---
// Career detail + application form (W3.3 / W3.4). SSR — reads
// /api/v1/public/careers/:slug and renders a real 404 when missing. The form
// submits to POST /api/v1/public/careers/:slug/applications (idempotent, §10).
export const prerender = false;

import PageLayout from '../../layouts/PageLayout.astro';
import { fetchCareer } from '../../lib/api';
import { employmentTypeLabels } from '../../lib/employmentTypes';

const { slug } = Astro.params;
const opening = slug ? await fetchCareer(slug) : null;

if (!opening) {
  Astro.response.status = 404;
}

const fieldClass =
  'h-11 w-full rounded-md border border-border bg-surface px-3 text-base text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent';
---

{
  opening ? (
    <PageLayout title={`${opening.title} — Somwave`} description={opening.summary}>
      <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
        <a href="/fursado-shaqo" class="text-sm font-semibold text-accent-600">
          ← Back to careers
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em]">
          <span class="text-accent-600">{employmentTypeLabels[opening.employmentType]}</span>
          <span class="text-border" aria-hidden="true">
            •
          </span>
          <span class="text-muted">{opening.location}</span>
        </div>
        <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
          {opening.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{opening.summary}</p>

        <div class="mt-8 whitespace-pre-line text-base leading-relaxed text-ink">
          {opening.description}
        </div>

        <h2 class="mt-12 text-2xl font-bold tracking-tight text-ink">Apply for this role</h2>
        <form
          id="application-form"
          class="mt-6 rounded-lg border border-border bg-surface p-6 shadow-sm"
          data-slug={opening.slug}
          novalidate
        >
          <div class="grid gap-4">
            <label class="grid gap-1.5">
              <span class="text-sm font-medium text-ink">Name</span>
              <input class={fieldClass} type="text" name="name" autocomplete="name" required />
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-medium text-ink">Email</span>
              <input class={fieldClass} type="email" name="email" autocomplete="email" required />
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-medium text-ink">
                Phone <span class="text-muted">(optional)</span>
              </span>
              <input class={fieldClass} type="tel" name="phone" autocomplete="tel" />
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-medium text-ink">
                CV link <span class="text-muted">(optional)</span>
              </span>
              <input class={fieldClass} type="url" name="resumeUrl" placeholder="https://" />
            </label>
            <label class="grid gap-1.5">
              <span class="text-sm font-medium text-ink">
                Cover letter <span class="text-muted">(optional)</span>
              </span>
              <textarea
                class="min-h-32 w-full rounded-md border border-border bg-surface px-3 py-2 text-base text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                name="coverLetter"
                rows="5"
              />
            </label>
          </div>

          <button
            type="submit"
            class="mt-5 inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-surface transition-colors hover:bg-primary-600 disabled:opacity-50"
          >
            Submit application
          </button>

          <p id="form-status" class="mt-3 text-sm text-muted" role="status" aria-live="polite" />
        </form>
      </article>
    </PageLayout>
  ) : (
    <PageLayout title="Not found — Somwave" description="This page could not be found.">
      <section class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
        <h1 class="text-4xl font-extrabold tracking-tight text-ink">Not found</h1>
        <p class="mt-3 text-lg text-muted">This position could not be found or is now closed.</p>
        <a
          href="/fursado-shaqo"
          class="mt-8 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
        >
          View all positions
        </a>
      </section>
    </PageLayout>
  )
}

<script>
  import { applyToCareer } from '../../lib/api';

  const form = document.getElementById('application-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  if (form && statusEl) {
    const slug = form.dataset.slug ?? '';
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const optional = (value: FormDataEntryValue | null): string | undefined => {
        const trimmed = String(value ?? '').trim();
        return trimmed === '' ? undefined : trimmed;
      };
      const input = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        phone: optional(data.get('phone')),
        resumeUrl: optional(data.get('resumeUrl')),
        coverLetter: optional(data.get('coverLetter')),
      };

      if (button) button.disabled = true;
      statusEl.textContent = 'Submitting…';
      statusEl.style.color = 'var(--color-muted)';

      try {
        await applyToCareer(slug, input, crypto.randomUUID());
        form.reset();
        statusEl.textContent =
          'Thank you! We received your application and will be in touch.';
        statusEl.style.color = 'var(--color-success)';
      } catch (error) {
        statusEl.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        statusEl.style.color = 'var(--color-error)';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
