---
// About (W2.2). Static marketing copy — company story, not CMS-managed.
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Ku saabsan — Somwave"
  description="Somwave waa shirkad teknoolaji oo ku dhisan Muqdisho: website, nidaamyo gudaha, iyo portal macaamiisha."
>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Ku saabsan</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      Hal koox, saddex dusha
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Somwave waxay u dhistaa ganacsiyada xalal dijital ah oo cad: websayd dadweyne, nidaam gudaha ah
      oo shaqada maamula, iyo portal uu macmiilku ku arko mashruucyadiisa oo ku bixiyo biilasha.
    </p>
    <p class="mt-4 text-base leading-relaxed text-ink">
      Waxaan ku shaqeynaa Muqdisho. Luqadda koowaad waa Soomaali; English iyo Carabi waa la heli
      karaa. Lacagaha waxaa lagu kaydiyaa USD; SOS waa muujin.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-3">
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Websayd</h2>
        <p class="mt-2 text-sm text-muted">Adeegyada, shaqooyinka, iyo foomka xiriirka.</p>
      </li>
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Gudaha</h2>
        <p class="mt-2 text-sm text-muted">Mashruucyo, shaqaale, iyo maaliyad hal meel.</p>
      </li>
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Portal</h2>
        <p class="mt-2 text-sm text-muted">Macaamiishu waxay arkaan oo bixiyaan iyaga oo aan wicin.</p>
      </li>
    </ul>
    <a
      href="/nala-soo-xiriir"
      class="mt-10 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
    >
      Nala soo xiriir
    </a>
  </section>
</PageLayout>
