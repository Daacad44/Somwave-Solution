---
// About (W2.2). Static marketing copy — company story, not CMS-managed.
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="About — Somwave"
  description="Somwave is a Mogadishu-based technology company building websites, business systems, and client experiences."
>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">About</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      One team, connected experiences
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Somwave builds connected digital solutions for businesses: public websites, systems that
      support daily operations, and portals where clients can follow projects and pay invoices.
    </p>
    <p class="mt-4 text-base leading-relaxed text-ink">
      We work from Mogadishu. Our public website opens in English, with additional language
      options for navigation. Financial records use USD, with SOS available for display.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-3">
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Website</h2>
        <p class="mt-2 text-sm text-muted">Services, portfolio, and a direct way to contact us.</p>
      </li>
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Operations</h2>
        <p class="mt-2 text-sm text-muted">Projects, people, and finances in one place.</p>
      </li>
      <li class="rounded-lg border border-border bg-surface p-5">
        <h2 class="text-lg font-semibold text-ink">Portal</h2>
        <p class="mt-2 text-sm text-muted">Clients can review projects and pay invoices online.</p>
      </li>
    </ul>
    <a
      href="/nala-soo-xiriir"
      class="mt-10 inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-surface hover:bg-primary-600"
    >
      Get in touch
    </a>
  </section>
</PageLayout>
