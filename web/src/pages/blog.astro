---
// Blog listing (W3.2). SSR — reads /api/v1/public/posts at request time.
// Only published posts are returned; drafts never reach this page.
export const prerender = false;

import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import { fetchPosts } from '../lib/api';
import { markCmsPageFresh } from '../lib/publicCache';
import type { PublicPostSummary } from '@somwave/shared';

markCmsPageFresh(Astro.response.headers);

const requested = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(requested) && requested > 0 ? requested : 1;

let posts: PublicPostSummary[] = [];
let total = 0;
let pageSize = 20;
let failed = false;
try {
  const result = await fetchPosts({ page });
  posts = result.items;
  total = result.total;
  pageSize = result.pageSize;
} catch {
  failed = true;
}

const totalPages = pageSize > 0 ? Math.ceil(total / pageSize) : 0;
const pageHref = (next: number): string => (next <= 1 ? '/blog' : `/blog?page=${next}`);
---

<PageLayout
  title="Maqaallada — Somwave"
  description="Talooyin iyo fikrado ku saabsan teknoolajiyada iyo horumarinta ganacsiga online."
>
  <section class="mx-auto max-w-content px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent-600">Maqaallada</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
        Talooyin iyo fikrado
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Waxyaabaha aan ka barannay dhisidda xalal dijital ah oo shaqeeya.
      </p>
    </div>

    {
      failed ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Cilad ayaa dhacday markii maqaallada la soo raadinayay. Fadlan mar kale isku day.
        </p>
      ) : posts.length === 0 ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Weli maqaallo lama daabicin.
        </p>
      ) : (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard
              slug={post.slug}
              title={post.title}
              excerpt={post.excerpt}
              publishedAt={post.publishedAt}
              category={post.category}
              coverImage={post.coverImage}
              authorName={post.authorName}
            />
          ))}
        </div>
      )
    }

    {
      !failed && totalPages > 1 ? (
        <nav class="mt-10 flex items-center justify-between gap-4" aria-label="Bogagga maqaallada">
          {page > 1 ? (
            <a
              href={pageHref(page - 1)}
              class="inline-flex h-11 items-center rounded-md border border-border px-4 text-sm font-semibold text-ink hover:border-primary"
            >
              Bogga hore
            </a>
          ) : (
            <span />
          )}
          <p class="text-sm text-muted">
            Bogga {page} / {totalPages}
          </p>
          {page < totalPages ? (
            <a
              href={pageHref(page + 1)}
              class="inline-flex h-11 items-center rounded-md border border-border px-4 text-sm font-semibold text-ink hover:border-primary"
            >
              Bogga xiga
            </a>
          ) : (
            <span />
          )}
        </nav>
      ) : null
    }
  </section>
</PageLayout>
