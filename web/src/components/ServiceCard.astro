---
// A single service on the homepage overview (SYSTEM_PROMPT §6). The full,
// data-driven services list (from the Service model + /api/v1/public) is W2.
interface Props {
  title: string;
  description: string;
  href?: string;
}
const { title, description, href } = Astro.props;
---

<article class="rounded-lg border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
  <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-surface-alt">
    <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
  </div>
  <h3 class="text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-2 text-[15px] leading-relaxed text-muted">{description}</p>
  {
    href ? (
      <a
        href={href}
        class="mt-4 inline-flex h-11 items-center text-sm font-semibold text-accent-600 hover:text-primary"
      >
        Akhri wax badan
      </a>
    ) : null
  }
</article>
