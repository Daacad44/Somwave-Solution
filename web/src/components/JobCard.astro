---
import { EMPLOYMENT_TYPE_LABELS, type EmploymentType } from '@somwave/shared';

interface Props {
  slug: string;
  title: string;
  location: string;
  employmentType: EmploymentType;
  summary: string;
}
const { slug, title, location, employmentType, summary } = Astro.props;
---

<a
  href={`/fursado-shaqo/${slug}`}
  class="flex flex-col rounded-lg border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em]">
    <span class="text-accent-600">{EMPLOYMENT_TYPE_LABELS[employmentType]}</span>
    <span class="text-border" aria-hidden="true">•</span>
    <span class="text-muted">{location}</span>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{summary}</p>
  <span class="mt-4 text-sm font-semibold text-accent-600">Faahfaahin &amp; codso →</span>
</a>
