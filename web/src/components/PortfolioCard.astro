---
// A portfolio item on the listing (SYSTEM_PROMPT §6). Links to its detail page.
interface Props {
  slug: string;
  title: string;
  summary: string;
  client: string | null;
  coverImage: string | null;
}
const { slug, title, summary, client, coverImage } = Astro.props;
---

<a
  href={`/shaqooyinka/${slug}`}
  class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition-shadow hover:shadow-md"
>
  <div class="aspect-[16/10] w-full overflow-hidden bg-surface-alt">
    {
      coverImage ? (
        <img
          src={coverImage}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true" />
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    {client ? <span class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-600">{client}</span> : null}
    <h3 class="mt-1 text-lg font-semibold text-ink">{title}</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">{summary}</p>
  </div>
</a>
