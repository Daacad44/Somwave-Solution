---
// A portfolio item on the listing (SYSTEM_PROMPT §6). Links to its detail page.
import type { PortfolioCategory } from '@somwave/shared';
interface Props {
  slug: string;
  title: string;
  summary: string;
  client: string | null;
  category?: PortfolioCategory | null;
  coverImage: string | null;
}
const { slug, title, summary, client, category, coverImage } = Astro.props;
const categoryLabel = category ? { WEBSITE: 'Websites', MOBILE_APP: 'Mobile Apps', CUSTOM_SOFTWARE: 'Custom Software' }[category] : null;
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition-shadow hover:shadow-md">
  <div class="aspect-[16/10] w-full overflow-hidden bg-surface-alt">
    {
      coverImage ? (
        <img
          src={coverImage}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true" />
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    {categoryLabel ? <span class="text-xs font-semibold uppercase tracking-[0.12em] text-brand">{categoryLabel}</span> : null}
    {client ? <span class="text-xs font-semibold uppercase tracking-[0.12em] text-accent-600">{client}</span> : null}
    <h3 class="mt-1 text-lg font-semibold text-ink"><a href={`/shaqooyinka/${slug}`} class="hover:text-brand hover:underline">{title}</a></h3>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">{summary}</p>
    <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-5 text-sm font-bold">
      <a href={`/shaqooyinka/${slug}`} class="text-brand hover:underline">View project →</a>
      <a href={`/request-project?portfolio=${encodeURIComponent(slug)}`} class="text-brand hover:underline">Request similar</a>
    </div>
  </div>
</article>
