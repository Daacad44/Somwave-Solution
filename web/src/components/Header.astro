---
// Site header + primary navigation (SYSTEM_PROMPT §6). Uses logical properties so
// it flips cleanly when Arabic (RTL) is added later (§12).
// Services and process are homepage sections in W1; portfolio (W3) and the
// enquiry form (W2.4) arrive with their phases.
const links = [
  { href: '/', label: 'Guriga' },
  { href: '/adeegyada', label: 'Adeegyada' },
  { href: '/shaqooyinka', label: 'Shaqooyinka' },
  { href: '/blog', label: 'Maqaallada' },
  { href: '/nala-soo-xiriir', label: 'Nala soo xiriir' },
];
const portalUrl = 'https://app.somwave.com';
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur">
  <nav
    class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-4 sm:px-6"
    aria-label="Navigation-ka weyn"
  >
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-primary">
      <span class="inline-block h-3 w-3 rounded-full bg-accent" aria-hidden="true"></span>
      Somwave
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-muted transition-colors hover:text-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={portalUrl}
      class="inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-semibold text-surface transition-colors hover:bg-primary-600"
    >
      Portal-ka
    </a>
  </nav>
</header>
