---
// Original Somwave Solution wordmark. Do not redraw, recolor, or crop the artwork.
// This optimized, trimmed derivative preserves the official artwork and avoids
// downloading the large transparent source canvas on every page.
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}
const { class: className = '', size = 'md' } = Astro.props;
---

<span class:list={['brand-logo', size === 'sm' ? 'brand-logo-sm' : 'brand-logo-md', className]}>
  <img
    src="/brand/somwave-logo-compact.webp"
    alt="Somwave Solution"
    width="403"
    height="146"
    decoding="sync"
    loading="eager"
    fetchpriority="high"
    class="brand-logo-img"
  />
</span>

<style>
  .brand-logo {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
  }
  .brand-logo-sm {
    width: 148px;
    height: 40px;
  }
  .brand-logo-md {
    width: 176px;
    height: 48px;
  }
  .brand-logo-img {
    width: auto;
    height: 100%;
  }
</style>
