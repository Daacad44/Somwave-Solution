---
// Original Somwave Solution wordmark. Do not redraw, recolor, or crop the artwork.
// The source PNG includes large empty canvas; this frame zooms to the mark only.
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}
const { class: className = '', size = 'md' } = Astro.props;
---

<span class:list={['brand-logo', size === 'sm' ? 'brand-logo-sm' : 'brand-logo-md', className]}>
  <img
    src="/brand/somwave-logo.png"
    alt="Somwave Solution"
    width="2000"
    height="667"
    decoding="async"
    class="brand-logo-img"
  />
</span>

<style>
  .brand-logo {
    position: relative;
    display: inline-block;
    overflow: hidden;
    flex-shrink: 0;
  }
  .brand-logo-sm {
    width: 148px;
    height: 40px;
  }
  .brand-logo-md {
    width: 176px;
    height: 48px;
  }
  .brand-logo-img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: auto;
    max-width: none;
    height: 229%;
    transform: translate(-50%, -50%);
  }
</style>
