---
import HomeIcon from './home/HomeIcon.astro';
import { defaultSiteContent, type SiteContent } from '@somwave/shared';

interface Props { content?: SiteContent['hero'] }
const { content = defaultSiteContent.hero } = Astro.props;
const highlight = 'Technology Solutions';
const parts = content.headline.split(highlight);
const defaultImage = content.imageUrl === defaultSiteContent.hero.imageUrl;
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-heading">
  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-site items-center gap-10 px-4 pb-10 pt-14 sm:px-6 lg:min-h-[580px] lg:grid-cols-[minmax(0,1.08fr)_minmax(0,0.92fr)] lg:gap-10 lg:py-14">
    <div class="hero-copy relative z-10">
      <p class="section-kicker">{content.badge}</p>
      <h1 id="hero-heading" class="mt-6 max-w-2xl text-[clamp(2.45rem,4vw,3.9rem)] font-extrabold leading-[1.06] tracking-[-0.055em] text-primary">
        {parts.length === 2 ? <>{parts[0]}<span class="text-brand">{highlight}</span>{parts[1]}</> : content.headline}
      </h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-muted sm:text-lg">
        {content.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/nala-soo-xiriir" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-md bg-brand px-6 text-sm font-bold text-surface shadow-md transition-all hover:-translate-y-0.5 hover:bg-brand-600 hover:shadow-lg">
          Get Started <HomeIcon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/shaqooyinka" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-md border border-border bg-surface px-6 text-sm font-bold text-primary transition-colors hover:border-brand hover:text-brand">
          View Our Work <HomeIcon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <ul class="mt-10 grid max-w-xl gap-4 border-t border-border pt-6 text-xs font-semibold text-primary sm:grid-cols-3">
        <li class="flex items-center gap-2"><HomeIcon name="web" class="h-5 w-5 shrink-0 text-brand" /> Websites & apps</li>
        <li class="flex items-center gap-2"><HomeIcon name="software" class="h-5 w-5 shrink-0 text-brand" /> Business systems</li>
        <li class="flex items-center gap-2"><HomeIcon name="support" class="h-5 w-5 shrink-0 text-brand" /> Ongoing support</li>
      </ul>
    </div>

    <div class="hero-visual relative min-w-0 pb-8 pt-6 lg:py-10">
      <div class="hero-halo pointer-events-none absolute inset-0 rounded-full" aria-hidden="true"></div>
      <figure class="hero-frame relative overflow-hidden rounded-lg border border-border bg-surface p-2 shadow-float sm:p-3">
        {defaultImage ? <picture>
          <source type="image/webp" srcset="/images/hero-somwave-768.webp 768w, /images/hero-somwave-1200.webp 1200w, /images/hero-somwave-1536.webp 1536w" sizes="(max-width: 1023px) 100vw, 46vw" />
          <img src="/images/hero-somwave.png" width="1536" height="1024" alt="Illustrative Somwave management workspace interface" class="block h-auto w-full rounded-md" loading="eager" decoding="async" fetchpriority="high" />
        </picture> : <img src={content.imageUrl} width="1536" height="1024" alt="Somwave digital solution visual" class="block h-auto w-full rounded-md" loading="eager" decoding="async" fetchpriority="high" />}
        <figcaption class="sr-only">Illustrative interface preview; figures shown are not live business results.</figcaption>
      </figure>
      <div class="floating-note absolute -end-1 top-0 max-w-44 rounded-md border border-border bg-surface/95 px-4 py-3 text-xs font-bold leading-5 text-primary shadow-lg sm:end-0 sm:max-w-52">
        <span class="mb-1 block text-brand">✦ Made for your workflow</span>
        From idea to useful digital tools.
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: linear-gradient(115deg, var(--color-surface) 8%, var(--color-sky) 100%); }
  .hero-glow { background: radial-gradient(circle at 82% 42%, color-mix(in srgb, var(--color-cyan) 25%, transparent), transparent 35%); }
  .hero-halo { background: radial-gradient(circle, color-mix(in srgb, var(--color-brand) 17%, transparent), transparent 64%); transform: scale(1.12); }
  .hero-visual { animation: hero-slide 650ms 80ms both; }
  .floating-note { animation: note-float 6s ease-in-out infinite; }
  @keyframes hero-slide { from { transform: translateY(12px); } to { transform: translateY(0); } }
  @keyframes note-float { 50% { transform: translateY(-7px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-visual, .floating-note { animation: none; }
  }
</style>
