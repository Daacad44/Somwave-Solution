---
// Static premium hero — one visual, no carousel. The slider was removed with
// this component rewrite; `heroSlides` and `heroSlideOrder` remain in the CMS
// schema for data compatibility but are no longer rendered.
import HomeIcon from './home/HomeIcon.astro';
import { defaultSiteContent, type SiteContent } from '@somwave/shared';

interface Props {
  content?: SiteContent;
}
const { content = defaultSiteContent } = Astro.props;
const hero = content.hero;

// Split the headline on the last word so the final word (e.g. "Connected.") can
// be styled with the brand accent without needing a second CMS field.
const words = hero.headline.trim().split(/\s+/);
const accent = words.pop() ?? '';
const headlineLead = words.join(' ');

// Service strip under the headline — short, static labels. Links go to the
// Services page, so a click always lands somewhere useful.
const serviceStrip = [
  { key: 'web', label: 'Web & Mobile Development' },
  { key: 'automation', label: 'Cloud & IT Solutions' },
  { key: 'software', label: 'Business Systems' },
  { key: 'consult', label: 'Consulting & Support' },
] as const;

const stats = [
  { value: '100+', label: 'Projects Delivered' },
  { value: '50+', label: 'Happy Clients' },
  { value: '10+', label: 'Years Experience' },
  { value: '24/7', label: 'Technical Support' },
] as const;

// Hero image source. Default uses the hand-authored SVG skyline (no baked UI,
// no logos, no text). When an administrator uploads a photo through the CMS,
// that photo replaces the SVG; the SVG remains the fallback for the default
// state so a brand-new install never ships embedded screenshot UI.
const DEFAULT_SKYLINE = '/images/hero-skyline.svg';
const legacyBaked = new Set([
  '/images/hero-devices-1200.webp',
  '/images/hero-somwave-1200.webp',
  '/images/hero-software-1200.webp',
  '/images/hero-somwave.png',
  '/images/hero-architecture-1200.webp',
  '/images/hero-architecture-768.webp',
  '/images/hero-architecture-480.webp',
]);
const effectiveImage = legacyBaked.has(hero.imageUrl) ? DEFAULT_SKYLINE : hero.imageUrl;
const isSvg = effectiveImage.endsWith('.svg');
const isRemote = /^https:\/\//.test(effectiveImage);
// Only our bitmap hero ships size variants. SVG scales natively, remote
// (ImageKit) delivery handles its own responsive variants.
const srcset = !isSvg && !isRemote ? undefined : undefined;

// Floating performance highlights, overlaid as real HTML on top of the art.
// Positions are expressed as a percentage of the art container so they move
// with the layout and never collide with the image's own content (there is
// no baked UI in the SVG to collide with).
const floatingCards = [
  {
    id: 'growth',
    title: 'Drive Digital Growth',
    caption: 'From idea to impact',
    icon: 'analytics' as const,
    position: 'tl',
  },
  {
    id: 'projects',
    title: '100+ Projects',
    caption: 'Delivered end to end',
    icon: 'value' as const,
    position: 'tr',
    accent: true,
  },
  {
    id: 'secure',
    title: 'Secure & Scalable',
    caption: 'Enterprise-grade',
    icon: 'trust' as const,
    position: 'bl',
  },
  {
    id: 'custom',
    title: 'Custom Solutions',
    caption: 'Built for your business',
    icon: 'software' as const,
    position: 'br',
  },
] as const;
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-ambient-glow" data-hero-glow></span>
    <span class="hero-ambient-grid"></span>
  </div>

  <div
    class="mx-auto grid max-w-site items-center gap-10 px-4 pb-16 pt-10 sm:px-6 sm:pb-20 sm:pt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,.95fr)] lg:gap-14 lg:pb-24 lg:pt-16"
  >
    <div class="hero-copy relative z-10">
      <p class="hero-badge" data-reveal>
        <span class="hero-badge-dot" aria-hidden="true"></span>{hero.badge}
      </p>

      <h1 id="hero-heading" class="hero-headline" data-reveal>
        {headlineLead}
        {headlineLead ? ' ' : ''}
        <span class="hero-headline-accent">{accent}</span>
      </h1>

      <p class="hero-description" data-reveal>{hero.description}</p>

      <div class="hero-actions" data-reveal>
        <a href={hero.primaryHref} class="hero-cta hero-cta-primary" data-magnetic>
          <span>{hero.primaryLabel}</span>
          <HomeIcon name="arrow" class="h-4 w-4" />
        </a>
        {
          hero.secondaryLabel && hero.secondaryHref ? (
            <a href={hero.secondaryHref} class="hero-cta hero-cta-secondary" data-magnetic>
              <span>{hero.secondaryLabel}</span>
              <HomeIcon name="arrow" class="h-4 w-4" />
            </a>
          ) : null
        }
      </div>

      <ul class="hero-services" data-reveal aria-label="Core service areas">
        {
          serviceStrip.map((item) => (
            <li>
              <a href="/adeegyada" class="hero-service">
                <span class="hero-service-icon" aria-hidden="true">
                  <HomeIcon name={item.key} class="h-5 w-5" />
                </span>
                <span class="hero-service-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <dl class="hero-stats" data-reveal>
        {
          stats.map((stat) => (
            <div>
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-art" data-reveal>
      <div class="hero-art-frame" data-hero-tilt>
        <img
          src={effectiveImage}
          width="1200"
          height="900"
          alt={hero.imageAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero-art-image"
        />
      </div>

      <!-- Floating highlights. Real HTML, keyboard accessible, hidden from
           assistive tech because the headline + stats already carry the facts. -->
      <ul class="hero-floats" aria-hidden="true">
        {
          floatingCards.map((card) => (
            <li class:list={['hero-float', `hero-float-${card.position}`, card.accent && 'is-accent']}>
              <span class="hero-float-icon">
                <HomeIcon name={card.icon} class="h-5 w-5" />
              </span>
              <span class="hero-float-body">
                <strong>{card.title}</strong>
                <small>{card.caption}</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(1200px 600px at 85% 10%, rgb(0 126 255 / 0.1), transparent 60%),
      linear-gradient(180deg, #fff 0%, var(--color-sky, #eaf2ff) 100%);
  }

  .hero-ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-ambient-glow {
    position: absolute;
    top: var(--glow-y, 20%);
    left: var(--glow-x, 70%);
    width: 540px;
    height: 540px;
    transform: translate3d(-50%, -50%, 0);
    background: radial-gradient(circle, rgb(20 98 242 / 0.18) 0%, transparent 65%);
    border-radius: 50%;
    will-change: transform;
    transition: top 500ms ease, left 500ms ease;
  }

  .hero-ambient-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(20 98 242 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 98 242 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 50% 20%, #000 30%, transparent 80%);
    opacity: 0.4;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(20 98 242 / 0.18);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--color-brand, #0b2a67);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .hero-badge-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand, #1462f2);
    box-shadow: 0 0 0 4px rgb(20 98 242 / 0.15);
  }

  .hero-headline {
    margin-top: 1.5rem;
    max-width: 720px;
    color: var(--color-primary, #0b1f3a);
    font-size: clamp(2.3rem, 4.3vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-headline-accent {
    color: var(--color-brand, #1462f2);
    background: linear-gradient(
      120deg,
      var(--color-brand, #1462f2) 0%,
      var(--color-brand-strong, #0b47d1) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
  }

  .hero-description {
    margin-top: 1.5rem;
    max-width: 36rem;
    color: var(--color-muted, #4b5a7a);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 3rem;
    padding: 0 1.5rem;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 700;
    overflow: hidden;
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 220ms ease,
      background 220ms ease;
    will-change: transform;
  }

  .hero-cta-primary {
    background: var(--color-brand, #1462f2);
    color: #fff;
    box-shadow:
      0 8px 20px rgb(20 98 242 / 0.28),
      0 2px 6px rgb(20 98 242 / 0.18);
  }

  .hero-cta-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 20%, rgb(255 255 255 / 0.25) 50%, transparent 80%);
    transform: translateX(-100%);
    transition: transform 700ms ease;
  }

  .hero-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 14px 28px rgb(20 98 242 / 0.32),
      0 4px 10px rgb(20 98 242 / 0.22);
  }
  .hero-cta-primary:hover::before {
    transform: translateX(100%);
  }

  .hero-cta-secondary {
    background: rgb(255 255 255 / 0.9);
    color: var(--color-primary, #0b1f3a);
    border: 1px solid var(--color-border, #d8e0ef);
  }

  .hero-cta-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand, #1462f2);
    color: var(--color-brand, #1462f2);
    box-shadow: 0 10px 24px rgb(11 31 58 / 0.08);
  }

  .hero-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .hero-service {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.7);
    border: 1px solid rgb(216 224 239 / 0.6);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .hero-service:hover {
    transform: translateY(-2px);
    border-color: rgb(20 98 242 / 0.4);
    box-shadow: 0 10px 24px rgb(11 31 58 / 0.06);
  }

  .hero-service-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgb(20 98 242 / 0.1), rgb(20 98 242 / 0.03));
    color: var(--color-brand, #1462f2);
  }

  .hero-service-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary, #0b1f3a);
    line-height: 1.3;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(216 224 239 / 0.8);
  }

  .hero-stats div {
    text-align: start;
  }

  .hero-stats dt {
    font-size: clamp(1.5rem, 2.3vw, 1.9rem);
    font-weight: 800;
    color: var(--color-brand, #1462f2);
    letter-spacing: -0.02em;
  }

  .hero-stats dd {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-muted, #4b5a7a);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-art {
    position: relative;
    perspective: 1200px;
  }

  .hero-art-frame {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow:
      0 24px 60px -16px rgb(11 31 58 / 0.3),
      0 10px 30px -10px rgb(20 98 242 / 0.2);
    transform-style: preserve-3d;
    transform:
      perspective(1200px)
      rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .hero-art-image {
    display: block;
    width: 100%;
    height: auto;
    background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);
  }

  /* Floating performance highlights. Pure HTML; the SVG behind them has no
     text or UI, so these are the only labels on the hero art. */
  .hero-floats {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .hero-float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.9rem;
    min-width: 10rem;
    max-width: 13.5rem;
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(6px);
    border: 1px solid rgb(216 224 239 / 0.9);
    border-radius: 14px;
    box-shadow:
      0 10px 24px -8px rgb(11 31 58 / 0.18),
      0 2px 6px -2px rgb(11 31 58 / 0.08);
    pointer-events: auto;
    animation: hero-float 7s ease-in-out infinite;
  }

  .hero-float.is-accent {
    background: linear-gradient(135deg, #1462f2 0%, #0b47d1 100%);
    border-color: transparent;
    color: #fff;
    box-shadow:
      0 14px 32px -10px rgb(20 98 242 / 0.5),
      0 2px 6px rgb(20 98 242 / 0.2);
  }

  .hero-float-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgb(20 98 242 / 0.1);
    color: var(--color-brand, #1462f2);
    flex-shrink: 0;
  }
  .hero-float.is-accent .hero-float-icon {
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  .hero-float-body {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .hero-float-body strong {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary, #0b1f3a);
  }
  .hero-float-body small {
    font-size: 0.6875rem;
    color: var(--color-muted, #4b5a7a);
  }
  .hero-float.is-accent .hero-float-body strong,
  .hero-float.is-accent .hero-float-body small {
    color: #fff;
  }

  /* Four corners of the art container, nudged inward so they sit over the sky
     area and not the glass tower centre. */
  .hero-float-tl {
    top: 8%;
    left: -4%;
    animation-delay: 0s;
  }
  .hero-float-tr {
    top: 10%;
    right: -4%;
    animation-delay: 1.4s;
  }
  .hero-float-bl {
    bottom: 10%;
    left: -2%;
    animation-delay: 2.8s;
  }
  .hero-float-br {
    bottom: 8%;
    right: -2%;
    animation-delay: 4.2s;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* Scroll-reveal: start hidden, revealed by IntersectionObserver. */
  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  [data-reveal]:nth-child(2) {
    transition-delay: 60ms;
  }
  [data-reveal]:nth-child(3) {
    transition-delay: 120ms;
  }
  [data-reveal]:nth-child(4) {
    transition-delay: 180ms;
  }
  [data-reveal]:nth-child(5) {
    transition-delay: 240ms;
  }

  /* Tablet: pull cards inward so they stay inside the viewport. */
  @media (max-width: 1023px) {
    .hero-float-tl,
    .hero-float-bl {
      left: 2%;
    }
    .hero-float-tr,
    .hero-float-br {
      right: 2%;
    }
  }

  @media (max-width: 768px) {
    .hero-ambient-glow {
      display: none;
    }
    .hero-art-frame {
      transform: none !important;
    }
    .hero-services {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    /* Reduce to two cards on mobile — top-left and bottom-right — to avoid
       overpowering the image on a narrow screen. */
    .hero-float {
      min-width: 8.5rem;
      padding: 0.5rem 0.7rem;
    }
    .hero-float-tr,
    .hero-float-bl {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .hero-ambient-glow,
    .hero-art-frame,
    .hero-cta,
    .hero-service,
    .hero-float {
      transition: none !important;
      animation: none !important;
    }
    .hero-cta-primary::before {
      display: none;
    }
  }
</style>

<script>
  // Hero interactions. Pointer-only (touch skips magnetic/tilt), reduced-motion safe,
  // and torn down on Astro navigation so there's no listener leak.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarse = window.matchMedia('(pointer: coarse)');

    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            reveal.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    hero.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => reveal.observe(el));

    const glow = hero.querySelector<HTMLElement>('[data-hero-glow]');
    const tilt = hero.querySelector<HTMLElement>('[data-hero-tilt]');
    const buttons = hero.querySelectorAll<HTMLAnchorElement>('[data-magnetic]');
    const controller = new AbortController();
    const { signal } = controller;

    if (!reduced.matches && !coarse.matches) {
      let frame = 0;
      const onMove = (event: MouseEvent) => {
        if (frame) return;
        frame = window.requestAnimationFrame(() => {
          frame = 0;
          const rect = hero.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;
          glow?.style.setProperty('--glow-x', `${x}%`);
          glow?.style.setProperty('--glow-y', `${y}%`);
          if (tilt) {
            const dx = (event.clientX - rect.left) / rect.width - 0.5;
            const dy = (event.clientY - rect.top) / rect.height - 0.5;
            // Soft tilt (±4°) and parallax Y so the art tracks the pointer gently.
            tilt.style.setProperty('--tilt-x', `${-dy * 4}deg`);
            tilt.style.setProperty('--tilt-y', `${dx * 4}deg`);
          }
        });
      };
      const reset = () => {
        tilt?.style.setProperty('--tilt-x', '0deg');
        tilt?.style.setProperty('--tilt-y', '0deg');
      };
      hero.addEventListener('pointermove', onMove, { signal });
      hero.addEventListener('pointerleave', reset, { signal });

      // Magnetic CTAs: track pointer within a small radius; return smoothly on leave.
      buttons.forEach((button) => {
        let activeFrame = 0;
        button.addEventListener(
          'pointermove',
          (event: PointerEvent) => {
            if (activeFrame) return;
            activeFrame = window.requestAnimationFrame(() => {
              activeFrame = 0;
              const rect = button.getBoundingClientRect();
              const mx = event.clientX - rect.left - rect.width / 2;
              const my = event.clientY - rect.top - rect.height / 2;
              const strength = 0.25;
              button.style.transform = `translate(${mx * strength}px, ${my * strength}px)`;
            });
          },
          { signal },
        );
        button.addEventListener(
          'pointerleave',
          () => {
            button.style.transform = '';
          },
          { signal },
        );
      });
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        controller.abort();
        reveal.disconnect();
      },
      { once: true, signal },
    );
  }
</script>
