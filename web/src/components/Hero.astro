---
import BrandLogo from './BrandLogo.astro';
import HomeIcon from './home/HomeIcon.astro';
import { defaultSiteContent, type SiteContent, type HeroSlideId } from '@somwave/shared';

interface Props { content?: SiteContent }
const { content = defaultSiteContent } = Astro.props;
const byId = {
  intro: { id: 'intro' as const, ...content.hero },
  software: content.heroSlides.find((slide) => slide.id === 'software')!,
  connected: content.heroSlides.find((slide) => slide.id === 'connected')!,
};
const slides = content.heroSlideOrder.map((id: HeroSlideId) => byId[id]);
---

<section class="hero-slider relative overflow-hidden" aria-label="Somwave highlights" aria-roledescription="carousel" tabindex="0">
  <div class="hero-stage relative">
    {slides.map((slide, index) => {
      const imageUrl = slide.imageUrl === '/images/hero-somwave.png' ? '/images/hero-devices-1200.webp' : slide.imageUrl;
      return <article class:list={['hero-slide', index === 0 && 'is-active']} data-slide={index} aria-hidden={index === 0 ? 'false' : 'true'} inert={index !== 0}>
        <div class="hero-atmosphere" aria-hidden="true"></div>
        <div class="hero-inner mx-auto grid max-w-site items-center gap-9 px-4 sm:px-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,.95fr)] lg:gap-12">
          <div class="hero-copy relative z-10">
            <p class="section-kicker hero-entrance">{slide.badge}</p>
            {index === 0 ? <h1 id="hero-heading" class="hero-headline hero-entrance mt-6">{slide.headline}</h1> : <h2 class="hero-headline hero-entrance mt-6">{slide.headline}</h2>}
            <p class="hero-entrance mt-6 max-w-xl text-base leading-8 text-muted sm:text-lg">{slide.description}</p>
            <div class="hero-entrance hero-actions mt-8 flex flex-wrap gap-3">
              <a href={slide.primaryHref} class="inline-flex min-h-12 items-center justify-center gap-3 rounded-md bg-brand px-6 text-sm font-bold text-surface shadow-md transition-all hover:-translate-y-0.5 hover:bg-brand-600 hover:shadow-lg">{slide.primaryLabel} <HomeIcon name="arrow" class="h-4 w-4" /></a>
              {slide.secondaryLabel && slide.secondaryHref && <a href={slide.secondaryHref} class="inline-flex min-h-12 items-center justify-center gap-3 rounded-md border border-border bg-surface px-6 text-sm font-bold text-primary transition-colors hover:border-brand hover:text-brand">{slide.secondaryLabel} <HomeIcon name="arrow" class="h-4 w-4" /></a>}
            </div>
          </div>
          <div class="hero-art relative min-w-0" role="img" aria-label={slide.imageAlt}>
            <div class="hero-halo" aria-hidden="true"></div>
            {imageUrl ? <figure class="hero-frame relative overflow-hidden rounded-lg border border-border bg-surface p-2 shadow-float sm:p-3">
              {slide.id === 'intro' && imageUrl === '/images/hero-devices-1200.webp' ? <picture>
                <source type="image/webp" srcset="/images/hero-devices-768.webp 768w, /images/hero-devices-1200.webp 1200w" sizes="(max-width: 1023px) 100vw, 46vw" />
                <img src={imageUrl} width="1200" height="675" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : undefined} class="block h-auto w-full rounded-md" />
              </picture> : <img src={imageUrl} width="1200" height="675" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" class="block h-auto w-full rounded-md" />}
            </figure> : <div class="connected-art" aria-hidden="true">
              <span class="connected-orbit"></span><span class="connected-orbit connected-orbit-inner"></span>
              <span class="connected-core"><BrandLogo size="md" /></span>
              <span class="connected-satellite satellite-one"><HomeIcon name="web" /></span>
              <span class="connected-satellite satellite-two"><HomeIcon name="mobile" /></span>
              <span class="connected-satellite satellite-three"><HomeIcon name="payment" /></span>
              <span class="connected-satellite satellite-four"><HomeIcon name="analytics" /></span>
            </div>}
          </div>
        </div>
      </article>;
    })}
  </div>
  <div class="hero-controls relative z-10 mx-auto flex max-w-site items-center gap-4 px-4 pb-8 sm:px-6">
    <button type="button" class="hero-arrow" data-direction="prev" aria-label="Previous slide">←</button>
    <div class="flex items-center gap-2" role="group" aria-label="Choose a slide">
      {slides.map((slide, index) => <button type="button" class="hero-indicator" data-go={index} aria-label={`Show slide ${index + 1}: ${slide.headline}`} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}
    </div>
    <button type="button" class="hero-arrow" data-direction="next" aria-label="Next slide">→</button>
    <span class="hero-count ms-auto text-xs font-bold text-primary" aria-hidden="true">01 / 0{slides.length}</span>
  </div>
  <div class="hero-progress" aria-hidden="true"><span></span></div>
  <p class="sr-only hero-announcement" aria-live="polite"></p>
</section>

<style>
  .hero-slider { background: linear-gradient(115deg, #fff 8%, var(--color-sky) 100%); }
  .hero-stage { min-height: 650px; }
  .hero-slide { position: absolute; inset: 0; display: grid; align-items: center; opacity: 0; visibility: hidden; pointer-events: none; transform: scale(1.015); transition: opacity 850ms ease, transform 950ms ease, visibility 850ms; }
  .hero-slide.is-active { z-index: 1; opacity: 1; visibility: visible; pointer-events: auto; transform: scale(1); }
  .hero-atmosphere { position: absolute; inset: 0; background: radial-gradient(circle at 80% 42%, rgb(0 126 255 / .16), transparent 36%); }
  .hero-inner { width: 100%; padding-block: 4.5rem; }
  .hero-headline { max-width: 720px; color: var(--color-primary); font-size: clamp(2.55rem, 4vw, 3.9rem); font-weight: 800; line-height: 1.06; letter-spacing: -.055em; text-wrap: balance; }
  .hero-entrance { transition: transform 700ms ease, opacity 700ms ease; }
  .hero-slide:not(.is-active) .hero-entrance { transform: translateY(22px); opacity: 0; }
  .hero-slide.is-active .hero-actions { transition-delay: 180ms; }
  .hero-art { isolation: isolate; }
  .hero-halo { position: absolute; inset: -8%; z-index: -1; border-radius: 50%; background: radial-gradient(circle, rgb(20 98 242 / .23), transparent 68%); }
  .hero-arrow { display: grid; width: 44px; height: 44px; flex: none; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: white; color: var(--color-brand); font-size: 1.25rem; transition: background 180ms, transform 180ms; }
  .hero-arrow:hover { background: var(--color-brand-soft); transform: translateY(-2px); }
  .hero-indicator { display: grid; min-width: 34px; min-height: 44px; place-items: center; }
  .hero-indicator span { display: block; width: 8px; height: 8px; border-radius: 99px; background: #9eb3d5; transition: width 300ms, background 300ms; }
  .hero-indicator[aria-current='true'] span { width: 26px; background: var(--color-brand); }
  .hero-progress { height: 3px; background: rgb(20 98 242 / .1); }
  .hero-progress span { display: block; width: 0; height: 100%; background: var(--color-brand); }
  .hero-slider.is-playing .hero-progress span { animation: hero-timer 7s linear forwards; }
  @keyframes hero-timer { to { width: 100%; } }
  .connected-art { position: relative; width: min(100%, 490px); aspect-ratio: 1.15; margin-inline: auto; }
  .connected-orbit { position: absolute; inset: 8%; border: 1px dashed rgb(20 98 242 / .35); border-radius: 50%; }
  .connected-orbit-inner { inset: 20%; border-style: solid; box-shadow: 0 0 0 16px rgb(255 255 255 / .5); }
  .connected-core { position: absolute; inset: 28%; display: grid; place-items: center; border-radius: 50%; background: white; box-shadow: 0 20px 45px rgb(17 84 183 / .22); }
  .connected-core :global(.brand-logo) { transform: scale(.85); }
  .connected-satellite { position: absolute; display: grid; width: 56px; height: 56px; place-items: center; border-radius: 50%; background: white; color: var(--color-brand); box-shadow: var(--shadow-md); }
  .satellite-one { top: 11%; left: 25%; }.satellite-two { top: 50%; left: 3%; }.satellite-three { top: 14%; right: 13%; }.satellite-four { bottom: 12%; right: 18%; }
  @media (max-width: 767px) { .hero-stage { min-height: 790px; }.hero-inner { padding-block: 3.25rem 1rem; }.hero-art { width: min(100%, 520px); margin-inline: auto; }.hero-headline { font-size: clamp(2.2rem, 8.4vw, 3.6rem); } }
  @media (max-width: 390px) { .hero-stage { min-height: 825px; } }
  @media (prefers-reduced-motion: reduce) { .hero-slide, .hero-entrance, .hero-arrow, .hero-indicator span { transition: none; }.hero-progress { display: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.hero-slider');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-slide')];
    const indicators = [...root.querySelectorAll<HTMLButtonElement>('.hero-indicator')];
    const announcement = root.querySelector<HTMLElement>('.hero-announcement');
    const progress = root.querySelector<HTMLElement>('.hero-progress span');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const { signal } = controller;
    let current = 0;
    let timer: number | undefined;
    let remaining = 7000;
    let startedAt = 0;
    let hovered = false;
    let focused = false;
    let touchStartX: number | null = null;
    const pause = () => {
      if (timer !== undefined) {
        window.clearTimeout(timer);
        remaining = Math.max(0, remaining - (performance.now() - startedAt));
        timer = undefined;
      }
      root.classList.remove('is-playing');
      if (progress) progress.style.animationPlayState = 'paused';
    };
    const canPlay = () => !reduced.matches && !hovered && !focused && !document.hidden;
    const play = () => {
      if (!canPlay() || timer !== undefined) return;
      startedAt = performance.now();
      timer = window.setTimeout(() => show((current + 1) % slides.length, false), remaining);
      root.classList.add('is-playing');
      if (progress) progress.style.animationPlayState = 'running';
    };
    const show = (index: number, manual: boolean) => {
      pause();
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, position) => {
        const active = position === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.inert = !active;
      });
      indicators.forEach((indicator, position) => {
        if (position === current) indicator.setAttribute('aria-current', 'true');
        else indicator.removeAttribute('aria-current');
      });
      const count = root.querySelector<HTMLElement>('.hero-count');
      if (count) count.textContent = `0${current + 1} / 0${slides.length}`;
      if (manual && announcement) announcement.textContent = `Slide ${current + 1} of ${slides.length}: ${slides[current]?.querySelector('h1,h2')?.textContent ?? ''}`;
      remaining = 7000;
      if (progress) { progress.style.animation = 'none'; void progress.offsetWidth; progress.style.animation = ''; }
      play();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => button.addEventListener('click', () => show(current + (button.dataset.direction === 'next' ? 1 : -1), true), { signal }));
    indicators.forEach((button, index) => button.addEventListener('click', () => show(index, true), { signal }));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current + (event.key === 'ArrowRight' ? 1 : -1), true);
      }
    }, { signal });
    root.addEventListener('mouseenter', () => { hovered = true; pause(); }, { signal });
    root.addEventListener('mouseleave', () => { hovered = false; play(); }, { signal });
    root.addEventListener('focusin', () => { focused = true; pause(); }, { signal });
    root.addEventListener('focusout', () => { focused = root.contains(document.activeElement); if (!focused) play(); }, { signal });
    root.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? null; }, { passive: true, signal });
    root.addEventListener('touchend', (event) => {
      if (touchStartX === null) return;
      const delta = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (Math.abs(delta) > 50) show(current + (delta < 0 ? 1 : -1), true);
      touchStartX = null;
    }, { passive: true, signal });
    document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); else play(); }, { signal });
    reduced.addEventListener('change', () => { if (reduced.matches) pause(); else play(); }, { signal });
    document.addEventListener('astro:before-swap', () => { pause(); controller.abort(); }, { once: true, signal });
    play();
  }
</script>
