---
// Homepage hero (SYSTEM_PROMPT §6). Navy ground, amber accent — on the shared
// tokens. Amber carries text only on the dark ground here, which is AA-safe (§8).
---

<section class="relative overflow-hidden bg-primary text-surface">
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    style="background: radial-gradient(60% 60% at 85% 0%, rgb(245 158 11 / 0.18), transparent 60%), radial-gradient(50% 60% at 0% 100%, rgb(22 50 79 / 0.9), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-content px-4 py-24 sm:px-6 md:py-32">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">Somwave</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl md:text-6xl">
      Xalal dijital ah oo ganacsigaaga horumariya.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-surface/80">
      Waxaan dhisnaa website-yo dhaqso ah, nidaamyo gudaha ah, iyo barnaamijyo mobil oo shaqadaada
      fududeeya — naqshad casri ah iyo tayo lagu kalsoonaan karo.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href="/nala-soo-xiriir"
        class="inline-flex h-12 items-center rounded-md bg-accent px-6 text-base font-semibold text-primary transition-colors hover:bg-accent-600"
      >
        Mashruuc bilow
      </a>
      <a
        href="/adeegyada"
        class="inline-flex h-12 items-center rounded-md border border-surface/30 px-6 text-base font-semibold text-surface transition-colors hover:bg-surface/10"
      >
        Arag adeegyada
      </a>
    </div>
  </div>
</section>
