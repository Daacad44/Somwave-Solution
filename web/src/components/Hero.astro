---
import HomeIcon from './home/HomeIcon.astro';
---

<section class="relative overflow-hidden bg-surface">
  <div class="hero-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-rings pointer-events-none absolute -end-10 top-4 h-[380px] w-[380px] sm:end-6" aria-hidden="true"></div>

  <div
    class="relative mx-auto grid max-w-site items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.02fr_1fr] lg:gap-8 lg:py-20"
  >
    <div>
      <p
        class="inline-flex min-h-11 items-center rounded-full bg-brand-soft px-4 text-xs font-semibold text-brand"
      >
        Xalal Digital ah oo ka Dhigaya Ganacsigaaga Mid Casri ah
      </p>
      <h1
        class="mt-5 max-w-xl text-[2.35rem] font-extrabold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.25rem]"
      >
        Teknoolojiyad<br /><span class="text-brand">Horumarinaysa</span><br />Mustaqbalkaaga
      </h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
        Somwave Solution waxay u dhistaa website, barnaamijyo mobil, software gaar ah, iyo
        la-talin IT — nidaamyo dhab ah oo ganacsigaaga maamula.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/nala-soo-xiriir"
          class="inline-flex h-12 items-center rounded-md bg-brand px-6 text-sm font-semibold text-surface transition-colors hover:bg-brand-600"
        >
          Nala soo xiriir
        </a>
        <a
          href="/shaqooyinka"
          class="inline-flex h-12 items-center rounded-md border border-border bg-surface px-6 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
        >
          Eeg shaqooyinkayaga
        </a>
      </div>
      <a
        href="#shaqooyinkayaga"
        class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink"
      >
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand text-surface">
          <HomeIcon name="play" class="h-3.5 w-3.5" />
        </span>
        Daawo muuqaal
      </a>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div class="hero-frame" aria-hidden="true">
        <div class="hero-chrome">
          <span></span><span></span><span></span>
          <p>app.somwave.com</p>
        </div>
        <div class="hero-app">
          <aside>
            <i class="logo"></i>
            <i class="on"></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </aside>
          <div class="hero-main">
            <p class="hero-hi">Operations</p>
            <div class="hero-kpis">
              <div><b>Projects</b><strong>12</strong></div>
              <div><b>Tasks</b><strong>28</strong></div>
              <div><b>Clients</b><strong>8</strong></div>
              <div><b>Invoices</b><strong>5</strong></div>
            </div>
            <div class="hero-mid">
              <div class="hero-chart">
                <svg viewBox="0 0 160 64" preserveAspectRatio="none">
                  <polyline points="0,48 24,40 48,44 72,28 96,32 120,18 144,22 160,12"></polyline>
                  <polyline class="alt" points="0,54 24,50 48,46 72,42 96,40 120,34 144,30 160,26"></polyline>
                </svg>
              </div>
              <div class="hero-donut"></div>
            </div>
            <ul class="hero-rows">
              <li><span>Website Redesign</span><em>Active</em></li>
              <li><span>Mobile App</span><em>Planning</em></li>
              <li><span>Client Portal</span><em>Active</em></li>
            </ul>
          </div>
        </div>
      </div>
      <p class="sr-only">
        Muuqaal tusaale ah oo dashboard-ka Somwave. Tirooyinka ku jira ma aha xog dhab ah.
      </p>
      <div class="hero-float hero-float-a">
        <span class="hero-float-dot"></span>
        Ganacsigaaga Horumari
      </div>
      <div class="hero-float hero-float-c">
        <span class="hero-float-dot"></span>
        Fikradahaaga Riixoo Xaqiiqo
      </div>
      <div class="hero-float hero-float-b">
        <span class="hero-float-dot"></span>
        Taageero Joogto ah 24/7
      </div>
    </div>
  </div>
</section>

<style>
  .hero-wash {
    background:
      radial-gradient(
        70% 55% at 88% 20%,
        color-mix(in srgb, var(--color-brand) 10%, transparent),
        transparent 62%
      );
  }
  .hero-rings {
    background:
      radial-gradient(circle at 50% 50%, transparent 28%, color-mix(in srgb, var(--color-brand) 10%, transparent) 29%, transparent 31%),
      radial-gradient(circle at 50% 50%, transparent 40%, color-mix(in srgb, var(--color-brand) 8%, transparent) 41%, transparent 43%),
      radial-gradient(circle at 50% 50%, transparent 52%, color-mix(in srgb, var(--color-brand) 6%, transparent) 53%, transparent 55%),
      radial-gradient(circle at 50% 50%, transparent 64%, color-mix(in srgb, var(--color-brand) 5%, transparent) 65%, transparent 67%);
  }
  .hero-frame {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .hero-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    padding: 10px 12px;
  }
  .hero-chrome span {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--color-border);
  }
  .hero-chrome span:first-child {
    background: var(--color-error);
  }
  .hero-chrome span:nth-child(2) {
    background: var(--color-accent);
  }
  .hero-chrome span:nth-child(3) {
    background: var(--color-success);
  }
  .hero-chrome p {
    margin-inline-start: 8px;
    border-radius: 999px;
    background: var(--color-surface);
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .hero-app {
    display: grid;
    grid-template-columns: 52px 1fr;
    min-height: 280px;
    background: var(--color-surface-alt);
  }
  .hero-app aside {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-primary);
    padding: 12px 10px;
  }
  .hero-app aside i {
    display: block;
    height: 8px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-surface) 22%, transparent);
  }
  .hero-app aside .logo {
    height: 16px;
    border-radius: 6px;
    background: var(--color-brand);
  }
  .hero-app aside .on {
    background: var(--color-surface);
  }
  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
  }
  .hero-hi {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
  }
  .hero-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .hero-kpis div {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 8px;
  }
  .hero-kpis b {
    display: block;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .hero-kpis strong {
    display: block;
    margin-top: 2px;
    font-size: 16px;
    color: var(--color-ink);
  }
  .hero-mid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 8px;
  }
  .hero-chart,
  .hero-donut {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .hero-chart {
    height: 84px;
    padding: 8px;
  }
  .hero-chart svg {
    width: 100%;
    height: 100%;
  }
  .hero-chart polyline {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 2.5;
  }
  .hero-chart .alt {
    stroke: var(--color-success);
  }
  .hero-donut {
    background:
      radial-gradient(circle at 50% 50%, var(--color-surface) 0 38%, transparent 39%),
      conic-gradient(
        var(--color-brand) 0 42%,
        var(--color-success) 42% 70%,
        var(--color-accent) 70% 88%,
        var(--color-border) 88% 100%
      );
  }
  .hero-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
  }
  .hero-rows em {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-success) 14%, var(--color-surface));
    color: var(--color-success);
    padding: 2px 6px;
    font-style: normal;
    font-size: 10px;
  }
  .hero-float {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero-float-dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--color-brand);
  }
  .hero-float-a {
    top: 6%;
    inset-inline-end: 0;
  }
  .hero-float-b {
    inset-inline-start: 0;
    bottom: 8%;
  }
  .hero-float-c {
    inset-inline-start: 6%;
    top: 42%;
  }
  @media (max-width: 1023px) {
    .hero-float-c {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .hero-kpis strong {
      font-size: 14px;
    }
    .hero-float {
      position: static;
      margin-top: 8px;
      width: fit-content;
    }
  }
</style>
