---
import { whyItems } from '../../lib/homeContent';
import HomeIcon from './HomeIcon.astro';
---

<section class="bg-primary text-surface" aria-labelledby="why-heading">
  <div class="mx-auto max-w-site px-4 py-20 sm:px-6">
    <p class="text-sm font-semibold text-surface/70">Maxaa Somwave?</p>
    <div class="mt-2 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 id="why-heading" class="max-w-xl text-3xl font-extrabold tracking-tight sm:text-4xl">
        Sababaha Ay Ganacsiyadu<br />Somwave U Doortaan
      </h2>
      <a
        href="/nala-soo-xiriir"
        class="inline-flex h-12 w-fit items-center rounded-md bg-brand px-6 text-sm font-semibold text-surface transition-colors hover:bg-brand-600"
      >
        Nagala shaqee
      </a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        whyItems.map((item) => (
          <article class="rounded-lg bg-surface p-6 text-ink shadow-sm">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-md bg-brand-soft text-brand">
              <HomeIcon name={item.icon} />
            </div>
            <h3 class="text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
