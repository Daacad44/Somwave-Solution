---
import { defaultSiteContent, type SiteContent } from '@somwave/shared';
interface Props { content?: SiteContent['cta'] }
const { content = defaultSiteContent.cta } = Astro.props;
---

<section class="relative overflow-hidden bg-primary text-surface" aria-labelledby="cta-heading">
  {content.backgroundImageUrl && <img src={content.backgroundImageUrl} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-25" aria-hidden="true" />}
  <div class="home-cta-wave pointer-events-none absolute inset-y-0 end-0 w-1/2" aria-hidden="true">
  </div>
  <div class="relative mx-auto max-w-site px-4 py-20 sm:px-6">
    <h2
      id="cta-heading"
      class="max-w-xl text-3xl font-extrabold tracking-tight sm:text-4xl"
    >
      {content.headline}
    </h2>
    <p class="mt-4 max-w-lg text-base leading-relaxed text-surface/75">
      {content.description}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/nala-soo-xiriir"
        class="inline-flex h-12 items-center rounded-md bg-brand px-6 text-sm font-semibold text-surface transition-colors hover:bg-brand-600"
      >
        Contact Us
      </a>
      <a
        href="/shaqooyinka"
        class="inline-flex h-12 items-center rounded-md border border-surface/25 px-6 text-sm font-semibold text-surface transition-colors hover:bg-surface/10"
      >
        View Our Portfolio
      </a>
    </div>
  </div>
</section>

<style>
  .home-cta-wave {
    background:
      radial-gradient(circle at 72% 50%, transparent 12%, color-mix(in srgb, var(--color-brand) 22%, transparent) 13%, transparent 15%),
      radial-gradient(circle at 72% 50%, transparent 22%, color-mix(in srgb, var(--color-brand) 20%, transparent) 23%, transparent 26%),
      radial-gradient(circle at 72% 50%, transparent 34%, color-mix(in srgb, var(--color-brand) 16%, transparent) 35%, transparent 38%),
      radial-gradient(circle at 72% 50%, transparent 48%, color-mix(in srgb, var(--color-brand) 12%, transparent) 49%, transparent 52%);
  }
</style>
