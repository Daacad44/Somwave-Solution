---
import { displayPostSummary } from '../../lib/seedTranslations';
import HomeIcon from './HomeIcon.astro';
import type { PublicPostSummary } from '@somwave/shared';

interface Props { posts: PublicPostSummary[] | null }
const { posts: source } = Astro.props;
const failed = source === null;
const posts = (source ?? []).map(displayPostSummary);

function dateLabel(iso: string): string {
  return new Intl.DateTimeFormat('en', {
    dateStyle: 'long',
    timeZone: 'Africa/Mogadishu',
  }).format(new Date(iso));
}
---

<section class="bg-surface" aria-labelledby="articles-heading">
  <div class="section-shell">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-kicker">Our insights</p>
        <h2
          id="articles-heading"
          class="section-title mt-4"
        >
          Latest Articles & Resources
        </h2>
      </div>
      <a
        href="/blog"
        class="inline-flex min-h-11 items-center text-sm font-bold text-brand hover:text-brand-600"
      >
        View all articles
      </a>
    </div>

    {
      failed ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Articles are unavailable right now. Please try again later.
        </p>
      ) : posts.length === 0 ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          No articles have been published yet.
        </p>
      ) : (
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {posts.map((item) => (
            <article class="premium-card flex flex-col overflow-hidden" data-reveal>
              <div class="aspect-[16/9] overflow-hidden bg-surface-alt">
                {
                  item.coverImage ? (
                    <img
                      src={item.coverImage}
                      alt=""
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                      class="block h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                    />
                  ) : (
                    <span class="flex h-full min-h-[168px] items-center justify-center" aria-hidden="true">
                      <span class="h-2.5 w-2.5 rounded-full bg-accent" />
                    </span>
                  )
                }
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-brand">
                  {item.category ? <span>{item.category.name}</span> : null}
                  {item.authorName ? (
                    <span class="font-medium normal-case tracking-normal text-muted">{item.authorName}</span>
                  ) : null}
                </div>
                <h3 class="mt-2 text-lg font-semibold text-ink">
                  <a href={`/blog/${item.slug}`} class="hover:text-brand">
                    {item.title}
                  </a>
                </h3>
                <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{item.excerpt}</p>
                <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium text-muted">
                  {item.publishedAt ? <time datetime={item.publishedAt}>{dateLabel(item.publishedAt)}</time> : null}
                  {item.readingMinutes ? <span>· About {item.readingMinutes} min read</span> : null}
                </div>
                <a
                  href={`/blog/${item.slug}`}
                  class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-brand"
                >
                  Read article
                  <HomeIcon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
