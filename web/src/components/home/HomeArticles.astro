---
import { fetchLatestPosts } from '../../lib/api';
import HomeIcon from './HomeIcon.astro';
import type { PublicPostSummary } from '@somwave/shared';

let posts: PublicPostSummary[] = [];
let failed = false;
try {
  posts = await fetchLatestPosts();
} catch {
  failed = true;
}

function dateLabel(iso: string): string {
  return new Intl.DateTimeFormat('so', {
    dateStyle: 'long',
    timeZone: 'Africa/Mogadishu',
  }).format(new Date(iso));
}
---

<section class="bg-surface" aria-labelledby="articles-heading">
  <div class="mx-auto max-w-site px-4 py-20 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-brand">Maqaallada Ugu Dambeeya</p>
        <h2
          id="articles-heading"
          class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Aqoonta Waa Horumar
        </h2>
      </div>
      <a
        href="/blog"
        class="inline-flex h-12 w-fit items-center rounded-md border border-border px-5 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
      >
        Dhammaan maqaallada
      </a>
    </div>

    {
      failed ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Cilad ayaa dhacday markii maqaallada la soo raadinayay. Fadlan mar kale isku day.
        </p>
      ) : posts.length === 0 ? (
        <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">
          Weli maqaallo lama daabicin.
        </p>
      ) : (
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {posts.map((item) => (
            <article class="flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition-shadow hover:shadow-md">
              <div class="aspect-[16/9] overflow-hidden bg-surface-alt">
                {
                  item.coverImage ? (
                    <img
                      src={item.coverImage}
                      alt=""
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                      class="block h-full w-full object-cover"
                    />
                  ) : (
                    <span class="flex h-full min-h-[168px] items-center justify-center" aria-hidden="true">
                      <span class="h-2.5 w-2.5 rounded-full bg-accent" />
                    </span>
                  )
                }
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-accent-600">
                  {item.category ? <span>{item.category.name}</span> : null}
                  {item.authorName ? (
                    <span class="font-medium normal-case tracking-normal text-muted">{item.authorName}</span>
                  ) : null}
                </div>
                <h3 class="mt-2 text-lg font-semibold text-ink">
                  <a href={`/blog/${item.slug}`} class="hover:text-brand">
                    {item.title}
                  </a>
                </h3>
                <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{item.excerpt}</p>
                {
                  item.publishedAt ? (
                    <time class="mt-2 text-xs font-medium text-muted" datetime={item.publishedAt}>
                      {dateLabel(item.publishedAt)}
                    </time>
                  ) : null
                }
                <a
                  href={`/blog/${item.slug}`}
                  class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-brand"
                >
                  Wax ka akhri
                  <HomeIcon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
