---
type Scene = 'shop' | 'school' | 'travel' | 'estate';
interface Props {
  scene: Scene;
  label: string;
}
const { scene, label } = Astro.props;
---

<div class:list={['preview', `preview-${scene}`]} role="img" aria-label={label}>
  {
    scene === 'shop' && (
      <div class="frame">
        <header class="bar dark">
          <strong>Dukaan</strong>
          <span>Alaab</span>
          <span>Shanta</span>
        </header>
        <div class="shop-hero">
          <p>Alaab cusub</p>
          <b>Iibso</b>
        </div>
        <div class="cards cards-4">
          <article><i class="swatch a" /><em>Telefoon</em><small>$99</small></article>
          <article><i class="swatch b" /><em>Saacad</em><small>$79</small></article>
          <article><i class="swatch c" /><em>Kabdhad</em><small>$129</small></article>
          <article><i class="swatch d" /><em>Laptop</em><small>$899</small></article>
        </div>
      </div>
    )
  }
  {
    scene === 'school' && (
      <div class="frame row">
        <aside class="rail">
          <strong>Iskuul</strong>
          <span class="on">Dashboard</span>
          <span>Arday</span>
          <span>Xaadirin</span>
          <span>Jadwal</span>
        </aside>
        <div class="pad">
          <div class="metrics">
            <p><small>Arday</small><b>640</b></p>
            <p><small>Macallin</small><b>24</b></p>
            <p><small>Fasal</small><b>18</b></p>
          </div>
          <div class="bars" aria-hidden="true">
            <i style="height:46%" />
            <i style="height:62%" />
            <i style="height:54%" />
            <i style="height:78%" />
            <i style="height:66%" />
            <i style="height:88%" />
          </div>
        </div>
      </div>
    )
  }
  {
    scene === 'travel' && (
      <div class="frame">
        <div class="sky">
          <p>Safarka xiga</p>
          <div class="search">
            <span>Muqdisho</span>
            <span>Dubai</span>
            <b>Raadi</b>
          </div>
        </div>
        <div class="cards cards-3">
          <article><i class="swatch a" /><em>Umrah</em><small>$1,299</small></article>
          <article><i class="swatch c" /><em>Istanbul</em><small>$890</small></article>
          <article><i class="swatch d" /><em>Maldives</em><small>$2,499</small></article>
        </div>
      </div>
    )
  }
  {
    scene === 'estate' && (
      <div class="frame">
        <header class="bar">
          <strong>Guryo</strong>
          <span>Iib</span>
          <span>Kiro</span>
          <b class="pill">Raadi</b>
        </header>
        <div class="cards cards-2">
          <article>
            <i class="swatch a tall" />
            <em>Villa — Jazeera</em>
            <small>$250,000</small>
          </article>
          <article>
            <i class="swatch b tall" />
            <em>Apartment — Hodan</em>
            <small>$800 / bil</small>
          </article>
        </div>
      </div>
    )
  }
</div>

<style>
  .preview,
  .frame {
    height: 100%;
    min-height: 168px;
  }
  .frame {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-surface-alt);
    padding: 10px;
  }
  .frame.row {
    flex-direction: row;
    background: var(--color-surface);
  }
  .bar,
  .rail {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bar {
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 6px 8px;
    font-size: 11px;
    color: var(--color-muted);
  }
  .bar.dark,
  .rail {
    background: var(--color-primary);
    color: var(--color-surface);
  }
  .bar strong,
  .rail strong {
    font-size: 12px;
  }
  .rail {
    width: 78px;
    flex-direction: column;
    align-items: stretch;
    border-radius: var(--radius-sm);
    padding: 10px 8px;
    font-size: 10px;
  }
  .rail .on {
    border-radius: 6px;
    background: var(--color-brand);
    padding: 4px;
  }
  .shop-hero,
  .sky {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-radius: var(--radius-md);
    background: linear-gradient(160deg, var(--color-brand), var(--color-primary));
    color: var(--color-surface);
    padding: 12px;
  }
  .shop-hero p,
  .sky p {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .shop-hero b,
  .search b,
  .pill {
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-primary);
    padding: 4px 8px;
    font-size: 10px;
  }
  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .search span {
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 600;
  }
  .cards {
    display: grid;
    flex: 1;
    gap: 8px;
  }
  .cards-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .cards-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .cards-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cards article {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 6px;
  }
  .swatch {
    display: block;
    height: 36px;
    border-radius: 4px;
    background: var(--color-brand-soft);
  }
  .swatch.b {
    background: color-mix(in srgb, var(--color-accent) 35%, var(--color-surface));
  }
  .swatch.c {
    background: color-mix(in srgb, var(--color-success) 24%, var(--color-surface));
  }
  .swatch.d {
    background: color-mix(in srgb, var(--color-brand) 22%, var(--color-surface));
  }
  .swatch.tall {
    height: 64px;
  }
  .cards em,
  .cards small {
    overflow: hidden;
    font-style: normal;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }
  .cards small {
    color: var(--color-muted);
    font-weight: 600;
  }
  .pad {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 8px;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .metrics p {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 6px;
  }
  .metrics small {
    display: block;
    color: var(--color-muted);
    font-size: 10px;
  }
  .metrics b {
    font-size: 13px;
  }
  .bars {
    display: flex;
    flex: 1;
    align-items: flex-end;
    gap: 6px;
    min-height: 64px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    padding: 8px;
  }
  .bars i {
    display: block;
    flex: 1;
    border-radius: 4px 4px 0 0;
    background: var(--color-brand);
  }
  .bars i:nth-child(odd) {
    background: var(--color-primary);
  }
  @media (max-width: 639px) {
    .cards-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
