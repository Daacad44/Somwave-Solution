---
import { trustedClients } from '../../lib/homeContent';
import { defaultSiteContent, type SiteContent } from '@somwave/shared';

interface Props { content?: SiteContent['trusted'] }
const { content = defaultSiteContent.trusted } = Astro.props;
const clients = trustedClients.filter((client) => content.visibleIds.includes(client.id));
---

{content.approved && clients.length > 0 && <section class="bg-surface" aria-labelledby="trusted-heading">
  <div class="section-shell !pt-10">
    <div class="mb-6 flex flex-wrap items-center justify-center gap-3 text-center">
      <h2 id="trusted-heading" class="text-sm font-bold tracking-wide text-primary sm:text-base">Trusted by leading businesses in Somalia</h2>
      <button id="logo-motion-toggle" type="button" class="rounded-full border border-border px-3 py-1.5 text-xs font-semibold text-muted hover:border-brand hover:text-brand" aria-label="Pause logo carousel" aria-pressed="false">Pause</button>
    </div>
    <div class="logo-viewport rounded-lg border border-border bg-surface px-3 py-5 shadow-sm">
      <div class="logo-track">
        {
          [false, true].map((duplicate) => (
            <ul class="logo-group" aria-hidden={duplicate ? 'true' : undefined}>
              {clients.map((client) => (
                <li class="logo-item">
                  <img
                    src={client.logo}
                    alt={duplicate ? '' : client.name}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>}

<style>
  .logo-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .logo-track {
    display: flex;
    width: max-content;
    animation: logo-scroll 28s linear infinite;
  }

  .logo-viewport:hover .logo-track,
  .logo-viewport:focus-within .logo-track,
  .logo-viewport.is-paused .logo-track,
  .logo-viewport.is-offscreen .logo-track {
    animation-play-state: paused;
  }

  .logo-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0 clamp(1.5rem, 4vw, 3.5rem) 0 0;
    list-style: none;
  }

  .logo-item {
    display: flex;
    width: clamp(8rem, 15vw, 10.5rem);
    height: 4.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
  }

  .logo-item img {
    display: block;
    max-width: 100%;
    max-height: 3.5rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @keyframes logo-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #logo-motion-toggle { display: none; }
    .logo-viewport {
      overflow: visible;
      mask-image: none;
    }

    .logo-track {
      width: 100%;
      animation: none;
    }

    .logo-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      padding: 0;
    }

    .logo-item {
      width: 100%;
    }

    .logo-group[aria-hidden='true'] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 640px) {
    .logo-group {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 1024px) {
    .logo-group {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>

<script>
  const viewport = document.querySelector<HTMLElement>('.logo-viewport');
  const toggle = document.querySelector<HTMLButtonElement>('#logo-motion-toggle');
  if (viewport && toggle) {
    toggle.addEventListener('click', () => {
      const paused = viewport.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Resume logo carousel' : 'Pause logo carousel');
      toggle.textContent = paused ? 'Play' : 'Pause';
    });
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        viewport.classList.toggle('is-offscreen', !entry?.isIntersecting);
      });
      observer.observe(viewport);
    }
  }
</script>
