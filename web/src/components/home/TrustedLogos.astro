---
import { trustedClients } from '../../lib/homeContent';
---

<section class="border-y border-border bg-surface" aria-labelledby="trusted-heading">
  <div class="mx-auto max-w-site px-4 py-10 sm:px-6">
    <p id="trusted-heading" class="text-center text-sm font-medium text-muted">Waxaa nala kalsoon</p>
    <ul
      class="mt-6 grid grid-cols-2 items-center justify-items-center gap-x-8 gap-y-5 sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        trustedClients.map((client) => (
          <li class="flex h-10 items-center justify-center sm:h-12">
            <img
              src={client.logo}
              alt={client.name}
              width={client.width}
              height={client.height}
              class="h-8 w-auto max-w-full object-contain sm:h-10"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
