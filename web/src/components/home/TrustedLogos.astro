---
import { trustedClients } from '../../lib/homeContent';
---

<section class="border-y border-border bg-surface" aria-labelledby="trusted-heading">
  <div class="mx-auto max-w-site px-4 py-10 sm:px-6">
    <p id="trusted-heading" class="text-center text-sm font-medium text-muted">Waxaa nala kalsoon</p>
    <ul
      class="mt-6 grid grid-cols-2 items-center justify-items-center gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        trustedClients.map((name) => (
          <li class="flex items-center gap-2 text-ink/40">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-current text-[10px] font-extrabold">
              {name.charAt(0)}
            </span>
            <span class="text-[11px] font-extrabold uppercase tracking-[0.12em] sm:text-xs">
              {name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
