---
type Name =
  | 'web'
  | 'mobile'
  | 'software'
  | 'consult'
  | 'skill'
  | 'trust'
  | 'support'
  | 'value'
  | 'quote'
  | 'arrow'
  | 'play'
  | 'menu'
  | 'close';

interface Props {
  name: Name;
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'web' ? (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8M12 17v4" />
      </>
    ) : name === 'mobile' ? (
      <rect x="7" y="2" width="10" height="20" rx="2" />
    ) : name === 'software' ? (
      <>
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
      </>
    ) : name === 'consult' ? (
      <>
        <path d="M4 12a8 8 0 0 1 16 0" />
        <path d="M4 12v5a2 2 0 0 0 2 2h2v-7" />
        <path d="M20 12v5a2 2 0 0 1-2 2h-2v-7" />
      </>
    ) : name === 'skill' ? (
      <>
        <circle cx="12" cy="8" r="3" />
        <path d="M5 20a7 7 0 0 1 14 0" />
      </>
    ) : name === 'trust' ? (
      <path d="M12 3 5 6v6c0 5 3.2 7.8 7 9 3.8-1.2 7-4 7-9V6l-7-3Z" />
    ) : name === 'support' ? (
      <>
        <path d="M3 12v4a2 2 0 0 0 2 2h2v-8H5a2 2 0 0 0-2 2Z" />
        <path d="M21 12v4a2 2 0 0 1-2 2h-2v-8h2a2 2 0 0 1 2 2Z" />
        <path d="M5 10a7 7 0 0 1 14 0" />
      </>
    ) : name === 'value' ? (
      <>
        <path d="M12 2v20" />
        <path d="M17 7H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6" />
      </>
    ) : name === 'quote' ? (
      <path
        fill="currentColor"
        stroke="none"
        d="M7.2 18c-2.3 0-4.2-1.9-4.2-4.3 0-3.4 2.6-6.7 6.3-8.2l.7 1.5C7.4 8.2 6 10.3 6 12.4c.6-.4 1.4-.6 2.2-.6 1.7 0 3 1.3 3 3s-1.4 3.2-3 3.2Zm9.8 0c-2.3 0-4.2-1.9-4.2-4.3 0-3.4 2.6-6.7 6.3-8.2l.7 1.5c-2.6 1.2-4 3.3-4 5.4.6-.4 1.4-.6 2.2-.6 1.7 0 3 1.3 3 3s-1.4 3.2-3 3.2Z"
      />
    ) : name === 'arrow' ? (
      <path d="M5 12h14M13 6l6 6-6 6" />
    ) : name === 'play' ? (
      <path fill="currentColor" stroke="none" d="M9 7.5v9l8-4.5-8-4.5Z" />
    ) : name === 'menu' ? (
      <path d="M4 7h16M4 12h16M4 17h16" />
    ) : (
      <path d="M6 6l12 12M18 6 6 18" />
    )
  }
</svg>
