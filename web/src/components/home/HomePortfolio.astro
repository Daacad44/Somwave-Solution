---
import { homeProjects } from '../../lib/homeContent';
---

<section id="shaqooyinkayaga" class="bg-surface" aria-labelledby="portfolio-heading">
  <div class="mx-auto max-w-site px-4 py-20 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-brand">Shaqooyinkayaga</p>
        <h2
          id="portfolio-heading"
          class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Mashaariic Aan Ku Faanno
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
          Xulasho nidaamyo iyo goobo digital ah oo aan naqshadeyno oo aan dhisno.
        </p>
      </div>
      <a
        href="/shaqooyinka"
        class="inline-flex h-12 w-fit items-center rounded-md border border-border px-5 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
      >
        Dhamaan shaqooyinka
      </a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        homeProjects.map((item) => (
          <a
            href={`/shaqooyinka/tusaale/${item.slug}`}
            class="group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
          >
            <div class="aspect-[16/10] overflow-hidden bg-surface-alt">
              <img
                src={item.image}
                alt={item.title}
                width={item.imageWidth}
                height={item.imageHeight}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="text-sm font-medium text-brand">{item.category}</p>
              <h3 class="mt-1 text-lg font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-ink transition-colors group-hover:text-brand">
                Faahfaahin →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .group,
    .group img {
      transition: none;
    }
  }
</style>
