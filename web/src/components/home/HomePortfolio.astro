---
import HomeIcon from './HomeIcon.astro';
import type { PortfolioCategory, PublicPortfolioItem } from '@somwave/shared';

interface Props { projects: PublicPortfolioItem[] | null }
const { projects: source } = Astro.props;
const failed = source === null;
const projects = (source ?? []).filter((item) => item.featured).slice(0, 4);
const labels: Record<PortfolioCategory, string> = { WEBSITE: 'Websites', MOBILE_APP: 'Mobile Apps', CUSTOM_SOFTWARE: 'Custom Software' };
const categories = [...new Set(projects.map((item) => item.category).filter((value): value is PortfolioCategory => Boolean(value)))];
---

<section id="shaqooyinkayaga" class="bg-surface" aria-labelledby="portfolio-heading">
  <div class="section-shell">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-kicker">Our portfolio</p>
        <h2 id="portfolio-heading" class="section-title mt-4">Featured Projects</h2>
        <p class="mt-4 max-w-xl text-sm leading-7 text-muted sm:text-base">Explore client work published through our portfolio.</p>
      </div>
      <a href="/shaqooyinka" class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-brand hover:text-brand-600">View all projects <HomeIcon name="arrow" class="h-4 w-4" /></a>
    </div>

    {categories.length > 0 && <div class="mt-7 flex flex-wrap gap-2" role="group" aria-label="Filter featured projects">
      <button type="button" class="portfolio-filter rounded-full border border-brand bg-brand px-4 py-2 text-sm font-bold text-surface" data-filter="all" aria-pressed="true">All</button>
      {categories.map((category) => <button type="button" class="portfolio-filter rounded-full border border-border bg-surface px-4 py-2 text-sm font-bold text-muted hover:border-brand hover:text-brand" data-filter={category} aria-pressed="false">{labels[category]}</button>)}
    </div>}

    {failed ? (
      <p class="mt-10 rounded-lg border border-border bg-surface-alt p-6 text-muted">Projects are unavailable right now. Please try again later.</p>
    ) : projects.length === 0 ? (
      <div class="mt-10 rounded-lg border border-border bg-surface-alt p-8 text-center text-muted">
        <p class="font-semibold text-primary">New work is on its way.</p>
        <p class="mt-2 text-sm">Approved project stories will appear here when they are published.</p>
      </div>
    ) : (
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {projects.map((item) => (
          <a href={`/shaqooyinka/${item.slug}`} class="premium-card portfolio-card group flex flex-col overflow-hidden" data-category={item.category ?? ''} data-reveal>
            <div class="aspect-[4/3] overflow-hidden bg-sky">
              {item.coverImage ? (
                <img src={item.coverImage} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
              ) : (
                <div class="portfolio-placeholder flex h-full items-center justify-center text-brand" aria-hidden="true"><span class="relative z-10 flex h-20 w-20 items-center justify-center rounded-lg border border-brand/15 bg-surface/90 shadow-lg"><HomeIcon name={item.category === 'MOBILE_APP' ? 'mobile' : 'software'} class="h-10 w-10" /></span></div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-brand">{item.category ? labels[item.category] : 'Project'}</p>
              <h3 class="mt-2 text-base font-bold text-primary">{item.title}</h3>
              <p class="mt-2 line-clamp-3 flex-1 text-sm leading-6 text-muted">{item.summary}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand">View project <HomeIcon name="arrow" class="h-4 w-4" /></span>
            </div>
          </a>
        ))}
      </div>
    )}
    {categories.length > 0 && <p class="portfolio-filter-status sr-only" role="status" aria-live="polite"></p>}
  </div>
</section>

<style>
  .portfolio-card[hidden] { display: none; }
  .portfolio-placeholder { background: radial-gradient(circle at 25% 20%, color-mix(in srgb, var(--color-cyan) 24%, transparent), transparent 34%), linear-gradient(135deg, var(--color-sky), var(--color-brand-soft)); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter');
  const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');
  const status = document.querySelector<HTMLElement>('.portfolio-filter-status');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const selected = button.dataset.filter ?? 'all';
    buttons.forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('bg-brand', active);
      item.classList.toggle('border-brand', active);
      item.classList.toggle('text-surface', active);
      item.classList.toggle('bg-surface', !active);
      item.classList.toggle('border-border', !active);
      item.classList.toggle('text-muted', !active);
    });
    let count = 0;
    cards.forEach((card) => {
      card.hidden = selected !== 'all' && card.dataset.category !== selected;
      if (!card.hidden) count += 1;
    });
    if (status) status.textContent = `${count} ${count === 1 ? 'project' : 'projects'} shown`;
  }));
</script>
