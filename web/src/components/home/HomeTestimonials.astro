---
import HomeIcon from './HomeIcon.astro';
import type { PublicTestimonial } from '@somwave/shared';

interface Props { testimonials: PublicTestimonial[] | null }
const { testimonials: source } = Astro.props;
const testimonials = source ?? [];
---

{testimonials.length > 0 && (
  <section id="marag-furka-home" class="bg-surface" aria-labelledby="testimonials-heading">
    <div class="section-shell">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="section-kicker">Testimonials</p>
          <h2 id="testimonials-heading" class="section-title mt-4">What Our Clients Say</h2>
        </div>
        {testimonials.length > 1 && (
          <div class="flex gap-2">
            <button type="button" class="testimonial-prev flex h-11 w-11 items-center justify-center rounded-full border border-border text-brand hover:border-brand" aria-label="Previous testimonial">←</button>
            <button type="button" class="testimonial-next flex h-11 w-11 items-center justify-center rounded-full border border-border text-brand hover:border-brand" aria-label="Next testimonial">→</button>
          </div>
        )}
      </div>
      <div class="testimonial-track mt-9 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4">
        {testimonials.map((item) => (
          <figure class="premium-card flex min-w-[min(85vw,350px)] max-w-[350px] snap-start flex-col p-6">
            <HomeIcon name="quote" class="h-8 w-8 text-brand" />
            <blockquote class="mt-4 flex-1 text-sm leading-7 text-primary">“{item.quote}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-4">
              {item.avatarUrl ? <img src={item.avatarUrl} alt="" width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full object-cover" /> : <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-soft font-bold text-brand" aria-hidden="true">{item.author.charAt(0)}</span>}
              <span><strong class="block text-sm text-primary">{item.author}</strong>{item.role || item.company ? <small class="text-xs text-muted">{[item.role, item.company].filter(Boolean).join(' · ')}</small> : null}</span>
              {item.rating ? <span class="ml-auto text-xs font-bold text-brand" aria-label={`${item.rating} out of 5 stars`}>{item.rating}/5</span> : null}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const track = document.querySelector<HTMLElement>('.testimonial-track');
  const previous = document.querySelector<HTMLButtonElement>('.testimonial-prev');
  const next = document.querySelector<HTMLButtonElement>('.testimonial-next');
  const move = (direction: number) => track?.scrollBy({ left: direction * ((track.querySelector('figure')?.getBoundingClientRect().width ?? 350) + 20), behavior: 'smooth' });
  previous?.addEventListener('click', () => move(-1));
  next?.addEventListener('click', () => move(1));
</script>
