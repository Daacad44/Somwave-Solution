---
import BrandLogo from './BrandLogo.astro';
import { chrome, DEFAULT_LOCALE } from '../lib/i18n';
import { defaultSiteContent, type SiteContent } from '@somwave/shared';

interface Props { content?: SiteContent; refresh?: boolean }
const { content = defaultSiteContent, refresh = false } = Astro.props;

const t = chrome[DEFAULT_LOCALE];
const year = new Date().getFullYear();
const quick = [
  { href: '/', key: 'nav.home' },
  { href: '/ku-saabsan', key: 'nav.about' },
  { href: '/adeegyada', key: 'nav.services' },
  { href: '/shaqooyinka', key: 'nav.portfolio' },
  { href: '/blog', key: 'nav.blog' },
];
const services = ['Software Development', 'Website Design', 'Mobile App Development', 'IT Consulting'];
const support = [
  { href: '/su-aalaha', key: 'nav.faq' },
  { href: '/fursado-shaqo', key: 'nav.careers' },
  { href: '/nala-soo-xiriir', key: 'nav.contact' },
  { href: 'https://app.somwave.botandev.com', key: 'cta.portal' },
];
---

<footer class="mt-0 border-t border-border bg-surface" data-cms-refresh={refresh ? 'true' : 'false'}>
  <div
    class="mx-auto grid max-w-site gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.1fr]"
  >
    <div>
      <a href="/" class="inline-flex min-h-11 items-center">
        <BrandLogo size="md" />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
        We build practical digital solutions for businesses, from websites and mobile apps to
        custom systems.
      </p>
      <a href="/nala-soo-xiriir" class="mt-4 inline-flex min-h-11 items-center text-sm font-bold text-brand hover:text-brand-600">Get in touch →</a>
      <ul id="footer-social" class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
        {content.contact.social.map((profile) => <li><a href={profile.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand hover:text-brand-600">{profile.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink" data-i18n="footer.quick">{t['footer.quick']}</h2>
      <ul class="mt-4 space-y-2">
        {
          quick.map((link) => (
            <li>
              <a
                href={link.href}
                data-i18n={link.key}
                class="inline-flex min-h-11 items-center text-sm text-muted transition-colors hover:text-brand"
              >
                {t[link.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink">Our Services</h2>
      <ul class="mt-4 space-y-2">
        {
          services.map((name) => (
            <li>
              <a href="/adeegyada" class="inline-flex min-h-11 items-center text-sm text-muted transition-colors hover:text-brand">{name}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-ink" data-i18n="footer.contact">{t['footer.contact']}</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
        <li id="footer-location">{content.contact.location}</li>
        <li><a id="footer-email" class="inline-flex min-h-11 items-center hover:text-brand" href={`mailto:${content.contact.email}`}>{content.contact.email}</a></li>
        <li><a id="footer-phone" class="inline-flex min-h-11 items-center hover:text-brand" href={`tel:${content.contact.phone.replace(/[^+\d]/g, '')}`}>{content.contact.phone}</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-brand" href="/nala-soo-xiriir">Contact form →</a></li>
        {support.map((link) => <li><a href={link.href} data-i18n={link.key} class="inline-flex min-h-11 items-center hover:text-brand">{t[link.key]}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto max-w-site px-4 py-8 sm:px-6">
      <h2 class="text-sm font-semibold text-ink" data-i18n="footer.newsletter.title">
        {t['footer.newsletter.title']}
      </h2>
      <p class="mt-1 max-w-md text-sm text-muted" data-i18n="footer.newsletter.desc">
        {t['footer.newsletter.desc']}
      </p>
      <form id="subscribe-form" class="mt-3 flex max-w-md flex-wrap gap-2" novalidate>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          aria-label="Your email address"
          class="h-11 min-w-56 flex-1 rounded-md border border-border bg-surface px-3 text-base text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        />
        <button
          type="submit"
          data-i18n="footer.newsletter.button"
          class="inline-flex h-11 items-center justify-center rounded-md bg-brand px-5 text-sm font-semibold text-surface transition-colors hover:bg-brand-600 disabled:opacity-50"
        >
          {t['footer.newsletter.button']}
        </button>
      </form>
      <p id="subscribe-status" class="mt-2 text-sm text-muted" role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-site flex-col gap-3 px-4 py-5 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p>
        © {year} Somwave Solution. <span data-i18n="footer.rights">{t['footer.rights']}</span>
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li>
          <a href="/asturnaanta" class="hover:text-brand" data-i18n="footer.privacy"
            >{t['footer.privacy']}</a
          >
        </li>
        <li>
          <a href="/shuruudaha" class="hover:text-brand" data-i18n="footer.terms">{t['footer.terms']}</a>
        </li>
        <li>
          <a href="/asturnaanta#cookies" class="hover:text-brand" data-i18n="footer.cookies"
            >{t['footer.cookies']}</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  import { fetchSiteContent, subscribe } from '../lib/api';

  const footer = document.querySelector<HTMLElement>('footer[data-cms-refresh]');
  if (footer?.dataset.cmsRefresh === 'true') {
    fetchSiteContent().then((content) => {
      const location = document.getElementById('footer-location');
      const email = document.getElementById('footer-email') as HTMLAnchorElement | null;
      const phone = document.getElementById('footer-phone') as HTMLAnchorElement | null;
      const social = document.getElementById('footer-social');
      if (location) location.textContent = content.contact.location;
      if (email) { email.textContent = content.contact.email; email.href = `mailto:${content.contact.email}`; }
      if (phone) { phone.textContent = content.contact.phone; phone.href = `tel:${content.contact.phone.replace(/[^+\d]/g, '')}`; }
      if (social) {
        social.replaceChildren();
        content.contact.social.forEach((profile) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = profile.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.className = 'inline-flex min-h-11 items-center text-sm font-semibold text-brand hover:text-brand-600';
          link.textContent = profile.label;
          item.append(link);
          social.append(item);
        });
      }
    }).catch(() => {});
  }

  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('subscribe-status');
  if (form && statusEl) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = String(new FormData(form).get('email') ?? '').trim();
      if (button) button.disabled = true;
      statusEl.textContent = 'Subscribing…';
      statusEl.style.color = 'var(--color-muted)';
      try {
        await subscribe(email);
        form.reset();
        statusEl.textContent = 'Thank you! You are subscribed.';
        statusEl.style.color = 'var(--color-success)';
      } catch (error) {
        statusEl.textContent =
          error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        statusEl.style.color = 'var(--color-error)';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
