---
// A testimonial card (W5.1). Shows the quote, author, and an optional star rating.
interface Props {
  author: string;
  role: string | null;
  company: string | null;
  quote: string;
  avatarUrl: string | null;
  rating: number | null;
}
const { author, role, company, quote, avatarUrl, rating } = Astro.props;
const subtitle = [role, company].filter(Boolean).join(' · ');
---

<figure class="flex h-full flex-col rounded-lg border border-border bg-surface p-6 shadow-sm">
  {
    rating ? (
      <div class="flex gap-0.5" aria-label={`${rating} shan ka mid`}>
        {Array.from({ length: 5 }).map((_s, i) => (
          <span class={i < rating ? 'text-accent' : 'text-border'} aria-hidden="true">
            ★
          </span>
        ))}
      </div>
    ) : null
  }
  <blockquote class="mt-3 flex-1 text-[15px] leading-relaxed text-ink">“{quote}”</blockquote>
  <figcaption class="mt-5 flex items-center gap-3">
    {
      avatarUrl ? (
        <img
          src={avatarUrl}
          alt={author}
          loading="lazy"
          class="size-10 rounded-full border border-border object-cover"
        />
      ) : (
        <span
          class="flex size-10 items-center justify-center rounded-full bg-surface-alt text-sm font-semibold text-muted"
          aria-hidden="true"
        >
          {author.charAt(0)}
        </span>
      )
    }
    <div>
      <p class="text-sm font-semibold text-ink">{author}</p>
      {subtitle ? <p class="text-xs text-muted">{subtitle}</p> : null}
    </div>
  </figcaption>
</figure>
