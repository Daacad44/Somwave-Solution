# Web build-time env (SYSTEM_PROMPT §14 — PUBLIC_* are BUILDTIME vars in Coolify;
# set at runtime they are absent from the Astro/Vite bundle).
#
# Local: copy to .env
# Coolify public site: set as Buildtime (not Runtime):
#   PUBLIC_SITE_URL=https://somwave.botandev.com
#   PUBLIC_API_URL=https://api.somwave.botandev.com/api/v1
#
# Include /api/v1 — web/src/lib/api.ts concatenates paths such as /public/services.
# Public configuration only. Never put JWT_SECRET, DATABASE_URL, Redis, or keys here.

PUBLIC_API_URL=http://localhost:4000/api/v1
PUBLIC_SITE_URL=http://localhost:4321
