# Frontend build-time env (SYSTEM_PROMPT §14 — VITE_* are BUILDTIME vars in Coolify;
# set at runtime they are simply absent from the Vite bundle).
#
# Local: copy to .env.local
# Coolify dashboard image (frontend/Dockerfile) forces VITE_API_URL=/api/v1 and
# nginx proxies /api/ to https://api.somwave.botandev.com so login cookies stay
# first-party. Do not set VITE_API_URL to the public api.* origin in that image.
#
# Include /api/v1 — apiClient concatenates this with paths such as /auth/login.
# Public configuration only. Never put JWT_SECRET, DATABASE_URL, Redis, or keys here.

VITE_API_URL=http://localhost:4000/api/v1
